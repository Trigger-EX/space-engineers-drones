              <Program>const string VER="1.0-wasp-split";string Tag="WASP",StartMode="IDLE";double MaxSpeed=98,SepRange=70;enum Mode{IDLE,GUARD,HUNT,ASSIST,RTB,FOLLOW}Mode _mode=Mode.IDLE;double _now=0;long _tick=0;Vector3D _dynHome;
