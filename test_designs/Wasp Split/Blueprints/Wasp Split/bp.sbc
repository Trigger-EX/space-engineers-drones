}}if(alt.LengthSquared()&gt;0.5){_lnDir=Vector3D.Normalize(alt);_lnP0=Me.GetPosition();best=1;_lnMsg+=", thrust axis";}}if(best&lt;0)best=0;foreach(var t in _lnThr){double c=t.IsFunctional?Vector3D.Dot(t.WorldMatrix.Backward,_lnDir):0;
t.ThrustOverridePercentage=(!cut&amp;&amp;best&gt;0.3&amp;&amp;c&gt;0.15)?(float)Math.Max(0.01,c/best):0f;}foreach(var y in _lnGy){y.GyroOverride=true;y.Pitch=0;y.Yaw=0;y.Roll=0;}if(_lnCtl!=null)_lnCtl.DampenersOverride=false;
return true;}bool LaunchStep(double dt,bool idle,string startMode,bool homeOk,Vector3D home,Action&lt;string&gt;cmd){_lnTick++;_lnClock+=dt;_lnHomeOk=homeOk;_lnHome=home;LnRead();if(_lnS==2)return LnBurn(dt,idle,startMode,cmd);
if(_lnS==3)return false;bool changed=Me.CubeGrid!=_lnGrid;bool join=_lnClock-_lnJoinT&lt;3;if(!(changed||(_lnForce&amp;&amp;_lnTick%10==0)||_lnTick%(_lnS==1||_lnPending?10:60)==0||(join&amp;&amp;_lnTick%10==0)))return false;
_lnGrid=Me.CubeGrid;_lnDock=LnDocked();_lnPending=false;if(_lnS==0){if(_lnDock){if(!_lnHold){_lnS=1;_lnFree=0;if(!_lnArmed){_lnArmed=true;LnWrite(true);}}return false;}if(_lnHold&amp;&amp; !_lnForce)return false;
bool go=_lnForce||(_lnAuto&amp;&amp;(_lnArmed||(join&amp;&amp;idle&amp;&amp;LnComplete())));if(go&amp;&amp;LnReady()){LnBegin();return LnBurn(dt,idle,startMode,cmd);}return false;}if(_lnDock){_lnFree=0;return false;}if(++_lnFree&lt;2&amp;&amp; !changed)return false;
if(_lnAuto||_lnForce){if(LnReady()){LnBegin();return LnBurn(dt,idle,startMode,cmd);}return false;}_lnS=0;return false;}string LaunchStatus(){if(_lnS==1)return"Launch: docked, waiting for the release\n";
if(_lnS==2)return"Launch: take-off burn "+_lnT.ToString("0.0")+" s\n";if(_lnS==3)return _lnMsg!=""?"Launch: "+_lnMsg+"\n":"";if(_lnFused)return"Launch: held, this grid holds a printer\n";return _lnArmed?"Launch: armed\n":"";
}class Mate{public long Id;public Vector3D Pos,Vel;public double Seen;public long Tgt;public int Flags;}Dictionary&lt;long,Mate&gt;_mates=new Dictionary&lt;long,Mate&gt;();List&lt;long&gt;_gone=new List&lt;long&gt;();void ReadSwarm(){
while(_lSwarm.HasPendingMessage){var m=_lSwarm.AcceptMessage();if(!(m.Data is MyTuple&lt;long,Vector3D,Vector3D,long,int&gt;))continue;var d=(MyTuple&lt;long,Vector3D,Vector3D,long,int&gt;)m.Data;if(d.Item1==Me.CubeGrid.EntityId)continue;
Mate mt;if(!_mates.TryGetValue(d.Item1,out mt)){mt=new Mate{Id=d.Item1};_mates[d.Item1]=mt;}mt.Pos=d.Item2;mt.Vel=d.Item3;mt.Tgt=d.Item4;mt.Flags=d.Item5;mt.Seen=_now;}_gone.Clear();foreach(var kv in _mates)if(_now-kv.Value.Seen&gt;3)_gone.Add(kv.Key);
foreach(var id in _gone)_mates.Remove(id);}void CtorErr(string w,Exception ex){_crash="setup "+w+": "+ex.Message;Echo(_crash);}public Program(){try{GetBlocks();}catch(Exception ex){CtorErr("blocks",ex);
}try{string m=StartMode.Trim().ToUpperInvariant();if(m=="SATELLITE"||m=="SAT"||m=="ORBIT")FoSat=true;}catch(Exception ex){CtorErr("mode",ex);}Runtime.UpdateFrequency=UpdateFrequency.Update1;}void LoadFlightCfg(){
if(_fpb==null)return;var ini=new MyIni();MyIniParseResult res;if(!ini.TryParse(_fpb.CustomData,out res))return;Tag=ini.Get("Wasp","IGC Tag").ToString(Tag);StartMode=ini.Get("Wasp","Start Mode (GUARD/HUNT/ASSIST/IDLE)").ToString(StartMode);
MaxSpeed=ini.Get("Wasp","Combat Speed").ToDouble(MaxSpeed);SepRange=ini.Get("Wasp","Wingmate Separation Range").ToDouble(SepRange);}void GetBlocks(){var ctrls=new List&lt;IMyShipController&gt;();GridTerminalSystem.GetBlocksOfType(ctrls,b=&gt;b.IsSameConstructAs(Me)&amp;&amp;b.CanControlShip);
_rc=null;foreach(var c in ctrls)if(c is IMyRemoteControl){_rc=c;break;}if(_rc==null&amp;&amp;ctrls.Count&gt;0)_rc=ctrls[0];var g=Me.CubeGrid;GridTerminalSystem.GetBlocksOfType(_gyros,b=&gt;b.CubeGrid==g);GridTerminalSystem.GetBlocksOfType(_thr,b=&gt;b.CubeGrid==g);
GridTerminalSystem.GetBlocksOfType(_guns,b=&gt;b.CubeGrid==g&amp;&amp; !(b is IMyLargeTurretBase));GridTerminalSystem.GetBlocksOfType(_sensors,b=&gt;b.IsSameConstructAs(Me));GridTerminalSystem.GetBlocksOfType(_ai,b=&gt;b.CubeGrid==g&amp;&amp;(b.CustomName.Contains("[AI]")||b.BlockDefinition.ToString().Contains("OffensiveCombat")||b.BlockDefinition.ToString().Contains("FlightMovement")));
var fl=new List&lt;IMyProgrammableBlock&gt;();GridTerminalSystem.GetBlocksOfType(fl,b=&gt;b!=Me&amp;&amp;b.IsSameConstructAs(Me)&amp;&amp;b.CustomName.StartsWith("[Flight]",StringComparison.OrdinalIgnoreCase));var oldK=_fk;_fpb=null;
double best=double.MaxValue;foreach(var p in fl){if(p.CubeGrid!=g)continue;double q=(p.GetPosition()-Me.GetPosition()).LengthSquared();if(q&lt;best){best=q;_fpb=p;}}_fk=_fpb!=null?"WSPL"+_fpb.EntityId:"";
if(_fk!=oldK){_f2sN=0;_f2sTick=_tick;_down=false;}LoadFlightCfg();_lcd=Me.GetSurface(0);_lcd.ContentType=ContentType.TEXT_AND_IMAGE;_lcd.FontSize=0.75f;_lcd.Font="Monospace";string sig=Tag+"|"+_fk;if(sig!=_sig){
_sig=sig;LoadMods();}Listen();}void LoadMods(){FleetLoad(true);LaunchLoad();FollowLoad();}void Listen(){string k=Tag+"|"+_fk;if(k==_lsKey)return;_lsKey=k;foreach(var l in new[]{_lHome,_lCmd,_lSwarm,_lF2S,_lFlt,_lArg}
)if(l!=null)IGC.DisableBroadcastListener(l);_lHome=IGC.RegisterBroadcastListener(Tag+"_HOME");_lCmd=IGC.RegisterBroadcastListener(Tag+"_CMD");_lSwarm=IGC.RegisterBroadcastListener(Tag+"_SWARM");_lF2S=_fk!=""?IGC.RegisterBroadcastListener(_fk+".F2S"):null;
_lFlt=_fk!=""?IGC.RegisterBroadcastListener(_fk+".FLT"):null;_lArg=_fk!=""?IGC.RegisterBroadcastListener(_fk+".CMD"):null;}public void Main(string arg,UpdateType src){try{Tick(arg,src);if(_errRun&gt;0&amp;&amp;_tick%300==0){
_errRun=0;_crash="";}}catch(Exception ex){if(_crash!=ex.Message||_errRun++ %60==0){_crash=ex.Message;Echo("Script error: "+ex.Message);if(_lcd!=null)_lcd.WriteText("STAFF SCRIPT ERROR\n"+ex.Message+"\nSend this text to Claude.");
}}}void Tick(string arg,UpdateType src){if((src&amp;(UpdateType.Trigger|UpdateType.Terminal|UpdateType.Script|UpdateType.Mod))!=0&amp;&amp; !string.IsNullOrWhiteSpace(arg))Command(arg);if((src&amp;UpdateType.Update1)==0)return;
double dt=Runtime.TimeSinceLastRun.TotalSeconds;if(dt&lt;=0||dt&gt;0.5)dt=1.0/60.0;_now+=dt;_tick++;if(_tick%600==0||Me.CubeGrid!=_myGrid){_myGrid=Me.CubeGrid;GetBlocks();}ReadF2S();if(_f2sN&gt;0&amp;&amp;_down&amp;&amp;_tick%60==0)GetBlocks();
if(_rc==null|| !_rc.IsFunctional|| !_rc.IsSameConstructAs(Me)){if(_tick%60==0)GetBlocks();Watch(false);if(_tick%30==0)Display();return;}ReadIGC();FollowStep();if(_tick%10==5)PollSensors();bool burn=LaunchStep(dt,_mode==Mode.IDLE,StartMode,_dynHomeT&gt;0,_dynHome,Cb);
Relay();SendFol(burn);Watch(burn);if(_tick%30==0)Display();}void ReadF2S(){while(_lF2S!=null&amp;&amp;_lF2S.HasPendingMessage){var m=_lF2S.AcceptMessage();if(!(m.Data is MyTuple&lt;int,long,Vector3D,Vector3D,float,string&gt;))continue;
var d=(MyTuple&lt;int,long,Vector3D,Vector3D,float,string&gt;)m.Data;_fl=d.Item1;_mode=(Mode)Math.Min(d.Item1&amp;7,5);_tgtId=d.Item2;_tgtPos=d.Item3;_aimErr=d.Item4.X;_fireWin=d.Item4.Y;if(d.Item4.Z&gt;0.1)_aBrake=d.Item4.Z;
_batt=d.Item5;_gate=d.Item6;_f2sT=_now;_f2sTick=_tick;_f2sN++;}}void ReadIGC(){while(_lHome.HasPendingMessage){var m=_lHome.AcceptMessage();if(m.Data is Vector3D){_dynHome=(Vector3D)m.Data;_dynHomeT=_now;
}}while(_lCmd.HasPendingMessage){var m=_lCmd.AcceptMessage();if(m.Data is string)Local((string)m.Data);}while(_lArg!=null&amp;&amp;_lArg.HasPendingMessage){var m=_lArg.AcceptMessage();if(m.Data is string)Local((string)m.Data);
}FleetPump(Cb,p=&gt;{_dynHome=p;_dynHomeT=_now;});ReadSwarm();while(_lFlt!=null&amp;&amp;_lFlt.HasPendingMessage){var m=_lFlt.AcceptMessage();if(m.Data is MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;)FleetSend((MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;)m.Data);
}}Dictionary&lt;long,MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;&gt;_rel=new Dictionary&lt;long,MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;&gt;();void Relay(){foreach(var l in FleetTgtL)while(l.HasPendingMessage){
var m=l.AcceptMessage();if(m.Source==IGC.Me|| !(m.Data is MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;))continue;var d=(MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;)m.Data;if(FleetOk(d))_rel[d.Item1]=d;}
if(_fk==""||_tick-_f2sTick&gt;90){_rel.Clear();return;}_gone.Clear();foreach(var kv in _rel){if(_gone.Count&gt;=10)break;IGC.SendBroadcastMessage(_fk+".TGT",kv.Value,TransmissionDistance.CurrentConstruct);_gone.Add(kv.Key);
}foreach(var id in _gone)_rel.Remove(id);}void SendFol(bool burn){if(_fk=="")return;bool fol=_mode==Mode.FOLLOW;if(burn==_folBurn&amp;&amp;fol==_folFol&amp;&amp;_tick%(fol||burn?2:30)!=1)return;_folBurn=burn;_folFol=fol;
bool known=FollowKnown();Vector3D want=known&amp;&amp;fol?FollowWant(_rc.GetPosition(),_aBrake,Vector3D.Zero):Vector3D.Zero;int f=(known?1:0)|(_foOnFoot?2:0)|(burn?4:0)|(_now-_dynHomeT&lt;5?8:0);IGC.SendBroadcastMessage(_fk+".FOL",new MyTuple&lt;Vector3D,Vector3D,Vector3D,Vector3D,Vector3D,int&gt;(want,known?FollowPos():Vector3D.Zero,known?FollowVel():Vector3D.Zero,_dynHome,new Vector3D(FoEngage,FoLeash,0),f),TransmissionDistance.CurrentConstruct);
}void PollSensors(){foreach(var s in _sensors){if(!s.IsWorking)continue;_sensed.Clear();s.DetectedEntities(_sensed);foreach(var e in _sensed)FollowSensed(e);}}void Watch(bool burn){bool down=_f2sN&gt;0&amp;&amp;(_tick-_f2sTick&gt;90||(_fpb!=null&amp;&amp; !_fpb.IsWorking));
if(!down){_down=false;return;}if(burn||_lnS==2)return;bool first= !_down;_down=true;if(!first&amp;&amp;_now-_relT&lt;1)return;_relT=_now;foreach(var y in _gyros){y.GyroOverride=false;y.Pitch=0;y.Yaw=0;y.Roll=0;}foreach(var t in _thr)t.ThrustOverridePercentage=0;
if(_rc!=null)_rc.DampenersOverride=true;if(first){foreach(var a in _ai)a.Enabled=false;foreach(var g in _guns)if(g.IsFunctional)g.ApplyAction("Shoot_Off");}}void Local(string a){var w=a.Trim().ToLowerInvariant().Split(new[]{
' '},StringSplitOptions.RemoveEmptyEntries);if(w.Length==0)return;switch(w[0]){case"follow":case"escort":FoSetSat(false);break;case"satellite":case"sat":case"orbit":FoSetSat(true);break;case"armed":case"launch":case"disarm":LaunchCmd(w[0]);
break;case"reload":GetBlocks();LoadMods();break;}}void Fwd(string c){if(_fk!="")IGC.SendBroadcastMessage(_fk+".S2F",c,TransmissionDistance.CurrentConstruct);}void Command(string a){Local(a);Fwd(a);}void Cb(string c){
Local(c);Fwd(c);}void Display(){_sb.Clear();_sb.Append("WASP STAFF v").Append(VER).Append('\n');if(_fpb==null)_sb.Append("! no [Flight] PB on this construct\n");else if(_down||(_f2sN&gt;0&amp;&amp; !_fpb.IsWorking))_sb.Append("FLIGHT PB DOWN  ").Append((_now-_f2sT).ToString("0.0")).Append(" s silent\n");
else if(_f2sN==0)_sb.Append("Flight : waiting for the first message\n");else _sb.Append("Flight : link OK  F2S ").Append((_now-_f2sT).ToString("0.00")).Append(" s ago\n");_sb.Append("Mode   : ").Append(_mode).Append('\n');
if(_rc==null|| !_rc.IsFunctional)_sb.Append("! No working Remote Control / cockpit\n");_sb.Append(FollowStatus());if(_tgtId!=0){_sb.Append("Target : ").Append(_tgtId).Append("  range ").Append(_rc!=null?Vector3D.Distance(_tgtPos,_rc.GetPosition()).ToString("0"):"?").Append(" m\n");
_sb.Append("Aim err: ").Append(_aimErr.ToString("0.00")).Append(" / ").Append(_fireWin.ToString("0.00")).Append(" deg").Append((_fl&amp;8)!=0?"  FIRING":"").Append('\n');}else _sb.Append("Target : none\n\n");
int rk=(_fl&gt;&gt;8)&amp;255;_sb.Append("Battery: ").Append((_batt*100).ToString("0")).Append("%  Rockets ").Append(rk==255?"?":rk.ToString()).Append('\n');if(_gate!=""&amp;&amp;_tgtId!=0)_sb.Append("Hold   : ").Append(_gate).Append('\n');
_sb.Append("Hive   : ").Append(_mates.Count+1).Append((_fl&amp;16)!=0?"  !! UNDER FIRE":"").Append((_fl&amp;32)!=0?"  lock stale":"").Append((_fl&amp;64)!=0?"  AI searching":"").Append('\n');_sb.Append(LaunchStatus());
if(Me.OwnerId==0)_sb.Append("! PB has no owner: set ownership\n");if(_crash!="")_sb.Append("! ").Append(_crash).Append('\n');string s=_sb.ToString();if(_lcd!=null)_lcd.WriteText(s);Echo(s);}
