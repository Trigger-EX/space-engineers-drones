}bool AiModeOk(){return _mode==Mode.GUARD||_mode==Mode.HUNT;}IMyCubeGrid _myGrid;void CheckGrid(){if(Me.CubeGrid!=_myGrid){_myGrid=Me.CubeGrid;GetBlocks();}}
