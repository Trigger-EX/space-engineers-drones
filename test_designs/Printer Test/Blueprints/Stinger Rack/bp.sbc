}catch(Exception){}try{Echo(_screen);}catch(Exception){}}void Sect(string name,Action a){_where=name;try{a();}catch(Exception ex){Err(ex,null);}}void Tick(string arg,UpdateType src){if(!string.IsNullOrWhiteSpace(arg))Sect("command '"+arg+"'",()=&gt;Command(arg.Trim().ToLowerInvariant()));if((src&amp;UpdateType.Update10)==0)return;double dt=Runtime.TimeSinceLastRun.TotalSeconds;if(dt&lt;=0||dt&gt;2)dt=1/6.0;_now+=dt;_dt=dt;_tick++;if(_tick%60==0)Sect("GetBlocks",GetBlocks);Sect("IGC swarm messages",ReadSwarm);Sect("IGC target messages",ReadTargets);Sect("expire drones/targets",Expire);Sect("IGC home broadcast",()=&gt;{
