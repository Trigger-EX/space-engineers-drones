}void ReadSwarm(){foreach(var kv in _lSwarm){Dictionary&lt;long,double&gt;dict;if(kv.Value==null|| !_alive.TryGetValue(kv.Key,out dict))continue;while(kv.Value.HasPendingMessage){var m=kv.Value.AcceptMessage();if(m.Data is MyTuple&lt;long,Vector3D,Vector3D,long,int&gt;){long id=((MyTuple&lt;long,Vector3D,Vector3D,long,int&gt;)m.Data).Item1;if(!dict.ContainsKey(id)){_joinNext[kv.Key]=0;double ju;_joinUntil.TryGetValue(kv.Key,out ju);_joinUntil[kv.Key]=Math.Max(ju,_now+6);}dict[id]=_now;}}}}void ReadTargets(){foreach(var l in _lTgt){if(l==null)continue;while(l.HasPendingMessage){var m=l.AcceptMessage();if(!(m.Data is MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;))continue;
var d=(MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;)m.Data;if(d.Item4&lt;0)_targets.Remove(d.Item1);else _targets[d.Item1]=_now;}}}void Expire(){var drop=new List&lt;long&gt;();foreach(var dict in _alive.Values){drop.Clear();foreach(var kv in dict)if(_now-kv.Value&gt;6)drop.Add(kv.Key);foreach(var id in drop)dict.Remove(id);}drop.Clear();foreach(var kv in _targets)if(_now-kv.Value&gt;6)drop.Add(kv.Key);foreach(var id in drop)_targets.Remove(id);}int Alive(string tag){Dictionary&lt;long,double&gt;d;return _alive.TryGetValue(tag,out d)?d.Count:0;}int AliveAll(){int n=0;foreach(var d in _alive.Values)n+=d.Count;return n;
}bool InCycle(Bay b){return b.State=="BUILD"||b.State=="FINISH"||b.State=="CHARGE"||b.State=="ARM"||b.State=="RELEASE";}int Pending(string tag){int n=0;foreach(var b in _bays)if(b.Tag==tag&amp;&amp;InCycle(b))n++;return n;}int PendingAll(){int n=0;foreach(var b in _bays)if(InCycle(b))n++;return n;}void SendJoins(){foreach(var tag in _lSwarm.Keys){double ju,jn;if(!_joinUntil.TryGetValue(tag,out ju)|| !_joinNext.TryGetValue(tag,out jn))continue;if(_now&gt;=ju||_now&lt;jn)continue;_joinNext[tag]=_now+2;IGC.SendBroadcastMessage(tag+"_JOIN","join");if(FleetCh!="")IGC.SendBroadcastMessage(FleetCh+"_CMD","join");if(_rackLaunchLeft&gt;0){
