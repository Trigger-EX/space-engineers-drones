SetHold(b,false);if(b.State=="FAULT")b.State="IDLE";}break;case"relay":Relay=w.Length&lt;2||w[1]!="off";break;case"reload":LoadConfig();GetBlocks();_errs.Clear();_errTotal=0;foreach(var b in _bays)b.Printed=0;break;}}void Show(){int docked=0;foreach(var d0 in _bays)if(d0.State=="DOCKED")docked++;_sb.Clear();_sb.Append("HIVE MOTHER v").Append(VER).Append(Printing?"  PRINTING":"  STOPPED");if(_errs.Count&gt;0)_sb.Append("   !! ").Append(_errTotal).Append(" ERROR").Append(_errTotal==1?"":"S");_sb.Append('\n');if(RackMode)_sb.Append("Rack: ").Append(docked).Append(" docked, targets ").Append(_targets.Count).Append('\n');
else _sb.Append("Drones alive: ").Append(AliveAll()).Append(" / ").Append(MaxDrones).Append("   building ").Append(PendingAll()).Append('\n');foreach(var b in _bays){try{_sb.Append("Bay ").Append(b.N).Append(' ').Append(b.Tag).Append(": ").Append(b.State);if(b.Printed&gt;0)_sb.Append(" #").Append(b.Printed);if(b.Held)_sb.Append(" (held)");if(b.Piped&gt;=0&amp;&amp;b.Piped&lt;b.Welders.Count)_sb.Append("  PIPES ").Append(b.Piped).Append('/').Append(b.Welders.Count);if(b.State=="BUILD")_sb.Append("  ").Append(b.Rem&gt;=0?b.Rem+" left":"no projection");if(b.State=="FINISH"){long tot=b.HasBox?(long)(b.BMax.X-b.BMin.X+1)*(b.BMax.Y-b.BMin.Y+1)*(b.BMax.Z-b.BMin.Z+1):0;
_sb.Append("  ").Append(b.HasBox?"scan "+(tot&gt;0?100*b.ScanIdx/tot:0)+"%":"name check").Append(b.HavePass?", "+b.LBad+" unfinished":"").Append(", ").Append((int)(_now-b.FinishT)).Append(" s");}if(b.Msg!="")_sb.Append("\n   ").Append(b.Msg);}catch(Exception ex){_sb.Append("(display error ").Append(ex.GetType().FullName).Append(')');Err(ex,b);}_sb.Append('\n');}if(_bays.Count==0)_sb.Append("No bays: name a projector, welders and\na merge block with [Bay 1]\n");_sb.Append(ErrText());int ins=0,max=0;try{ins=Runtime.CurrentInstructionCount;max=Runtime.MaxInstructionCount;}catch(Exception){}_sb.Append("Ins: ").Append(ins).Append(" / ").Append(max).Append("  peak ").Append(_peakIns).Append('\n');
_screen=_sb.ToString();if(_lcd!=null){try{_lcd.WriteText(_screen);}catch(Exception){}}}
</Program>
