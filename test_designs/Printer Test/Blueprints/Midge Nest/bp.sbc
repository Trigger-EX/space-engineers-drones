_where="bay "+b.N+" RELEASE check separation";if(StillAttached(b)){if(b.FusedT&lt;=0)b.FusedT=_now;SetOn(b.Merge,false);SetOn(b.DMerge,false);b.Msg="separating... drone still on the printer grid";if(_now-b.FusedT&gt;FusedGrace){Fault(b,"FUSED: drone is still on the printer grid "+FusedGrace+" s after merge off - grind the drone's merge stalk by hand; see docs");SetHold(b,true);}break;}b.FusedT=0;b.Msg="";b.State="COOLDOWN";b.T=_now;_joinUntil[b.Tag]=Math.Max(_joinUntil[b.Tag],_now+JoinSeconds);_joinNext[b.Tag]=0;if(b.RackLaunch)_rackLaunchLeft=3;}break;case"COOLDOWN":_where="bay "+b.N+" COOLDOWN projector read";
