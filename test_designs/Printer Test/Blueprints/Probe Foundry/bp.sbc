}_tvD= -1;if(_now-_tvT&lt;0.5&amp;&amp;_tvF.LengthSquared()&gt;0.5){f=_tvF;u=_tvU;ff=Vector3D.Zero;}}public Program(){for(int i=0;i&lt;6;i++)_thrDir[i]=new List&lt;IMyThrust&gt;();Runtime.UpdateFrequency=UpdateFrequency.Update1;try{Load();GetBlocks();}catch(Exception ex){_err="init: "+ex.Message;}}void Load(){_ini.Clear();MyIniParseResult pr;if(!_ini.TryParse(Me.CustomData,out pr))_ini.Clear();Tag=Cfg("IGC Tag",Tag).ToUpperInvariant();HostTag=Cfg("Host Tag",HostTag).ToUpperInvariant();OrbitMargin=Cfg("Orbit Margin",OrbitMargin);OrbitMin=Cfg("Orbit Min",OrbitMin);OrbitSpeed=Cfg("Orbit Speed",OrbitSpeed);MaxSpeed=Cfg("Max Speed",MaxSpeed);
TurnRate=Cfg("Turn Rate",TurnRate);GroupSec=Cfg("Group Seconds",GroupSec);PowerSec=Cfg("Power Seconds",PowerSec);SettleSec=Cfg("Settle Seconds",SettleSec);LeadSpeed=Cfg("Lead Speed",LeadSpeed);RayPast=Cfg("Ray Past",RayPast);string o=_ini.ToString();if(o!=Me.CustomData)Me.CustomData=o;_lTgt=IGC.RegisterBroadcastListener(HostTag+"_TGT");_lHome=IGC.RegisterBroadcastListener(Tag+"_HOME");}string Cfg(string k,string d){if(!_ini.ContainsKey("Peeper",k))_ini.Set("Peeper",k,d);return _ini.Get("Peeper",k).ToString(d);}double Cfg(string k,double d){if(!_ini.ContainsKey("Peeper",k))_ini.Set("Peeper",k,d);
return _ini.Get("Peeper",k).ToDouble(d);}void GetBlocks(){_thr.Clear();_gyros.Clear();_cams.Clear();_tur.Clear();_mrg.Clear();_bay.Clear();GridTerminalSystem.GetBlocksOfType(_thr,b=&gt;b.CubeGrid==Me.CubeGrid);GridTerminalSystem.GetBlocksOfType(_gyros,b=&gt;b.CubeGrid==Me.CubeGrid);GridTerminalSystem.GetBlocksOfType(_cams,b=&gt;b.CubeGrid==Me.CubeGrid);GridTerminalSystem.GetBlocksOfType(_tur,b=&gt;b.CubeGrid==Me.CubeGrid);GridTerminalSystem.GetBlocksOfType(_mrg,b=&gt;b.CubeGrid==Me.CubeGrid);GridTerminalSystem.GetBlocksOfType(_bay,b=&gt;b.CustomName.Contains("[Bay "));var rcs=new List&lt;IMyRemoteControl&gt;();GridTerminalSystem.GetBlocksOfType(rcs,b=&gt;b.CubeGrid==Me.CubeGrid);
_rc=rcs.Count&gt;0?rcs[0]:null;foreach(var c in _cams)c.EnableRaycast=true;for(int i=0;i&lt;6;i++)_thrDir[i].Clear();if(_rc!=null){MatrixD m=_rc.WorldMatrix;Vector3D[]dirs={m.Forward,m.Backward,m.Left,m.Right,m.Up,m.Down};foreach(var t in _thr){Vector3D push=t.WorldMatrix.Backward;for(int i=0;i&lt;6;i++)if(Vector3D.Dot(push,dirs[i])&gt;0.9){_thrDir[i].Add(t);break;}}}_lcd=Me.GetSurface(0);_lcd.ContentType=ContentType.TEXT_AND_IMAGE;_lcd.FontSize=0.8f;}public void Main(string arg,UpdateType u){_tick++;_now+=Runtime.TimeSinceLastRun.TotalSeconds;try{if((u&amp;(UpdateType.Terminal|UpdateType.Trigger))!=0&amp;&amp;arg!="")Command(arg.Trim().ToLowerInvariant());
if(_tick%60==1)GetBlocks();ReadIGC();_docked=IsDocked();if(_rc==null|| !_rc.IsFunctional){_err="no Remote Control";Release();Display();return;}Step();if(_now-_lastBeat&gt;1){_lastBeat=_now;Beat();}if(_tick%20==0)Display();}catch(Exception ex){_err=ex.GetType().Name+": "+ex.Message;Release();}}void Command(string c){switch(c){case"scout":_force=true;SetMode(Mode.SCOUT);break;case"park":_force=true;SetMode(Mode.PARK);break;case"reload":Load();GetBlocks();break;case"armed":case"launch":break;}}bool IsDocked(){if(_force)return false;foreach(var m in _mrg)if(m.IsConnected)return true;foreach(var b in _bay)if(b.CubeGrid==Me.CubeGrid)return true;
return false;}void SetMode(Mode m){if(_mode!=m){_mode=m;_modeT=_now;}}void ReadIGC(){while(_lTgt.HasPendingMessage){var msg=_lTgt.AcceptMessage();if(!(msg.Data is MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;))continue;var d=(MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;)msg.Data;if(d.Item4&lt;0){if(d.Item1==_tid)_haveTgt=false;continue;}if(d.Item1!=_tid)_orbKey= -1;_tid=d.Item1;_tPos=d.Item2;_tVel=d.Item3;_tRad=d.Item4;_tgtSeen=_now;_haveTgt=true;}while(_lHome.HasPendingMessage){var msg=_lHome.AcceptMessage();if(msg.Data is Vector3D){_home=(Vector3D)msg.Data;_homeSet=true;}}}Vector3D TgtPos(){return _tPos+_tVel*(_now-_tgtSeen);
}void Step(){if(_docked){SetMode(Mode.DOCKED);Release();Rest();return;}if(_mode==Mode.DOCKED)SetMode(Mode.CLEAR);bool fresh=_haveTgt&amp;&amp;_now-_tgtSeen&lt;ParkAfter;double dt=Math.Max(0.016,Runtime.TimeSinceLastRun.TotalSeconds);Vector3D pos=_rc.GetPosition(),vel=_rc.GetShipVelocities().LinearVelocity;Vector3D wantV=Vector3D.Zero,face=Vector3D.Zero;if(_mode==Mode.CLEAR){Vector3D away=_homeSet&amp;&amp;(pos-_home).LengthSquared()&gt;1?Vector3D.Normalize(pos-_home):_rc.WorldMatrix.Backward;wantV=away*15;if(_now-_modeT&gt;ClearSec)SetMode(fresh?Mode.SCOUT:Mode.PARK);}else if(_mode==Mode.SCOUT||_mode==Mode.PARK){if(_mode==Mode.PARK&amp;&amp;fresh)SetMode(Mode.SCOUT);
if(_mode==Mode.SCOUT&amp;&amp; !fresh){SetMode(Mode.PARK);_orbKey= -1;}if(_mode==Mode.SCOUT){Vector3D tp=TgtPos();double R=Math.Max(OrbitMin,_tRad+OrbitMargin);if(_orbKey&lt;0){Vector3D rel=pos-tp;double rl=rel.Length();_theta=_theta0=Math.Atan2(rel.Z,rel.X);_phi0=rl&gt;1?Math.Asin(MathHelper.Clamp(rel.Y/rl,-1,1)):0;_orbKey=1;}_theta+=OrbitSpeed*dt;double phi=MathHelper.Clamp(_phi0+0.7*Math.Sin(0.37*(_theta-_theta0)),-1.2,1.2);Vector3D off=new Vector3D(Math.Cos(_theta)*Math.Cos(phi),Math.Sin(phi),Math.Sin(_theta)*Math.Cos(phi))*R;Vector3D want=tp+off;Vector3D e=want-pos;double sp=Math.Min(MaxSpeed,Math.Sqrt(2*6*Math.Max(0,e.Length()-2))+0.3);
wantV=_tVel+(e.LengthSquared()&gt;0.01?Vector3D.Normalize(e)*sp:Vector3D.Zero);face=tp-pos;_tvD=face.Length();Sample(tp);}else wantV=Vector3D.Zero;}Fly(wantV,vel,dt);if(face.LengthSquared()&gt;1)Aim(face);else HoldAttitude();}void Fly(Vector3D wantV,Vector3D vel,double dt){double mass=_rc.CalculateShipMass().PhysicalMass;Vector3D grav=_rc.GetNaturalGravity();Vector3D a=(wantV-vel)*1.5;double am=a.Length();if(am&gt;12)a*=12/am;ApplyThrust((a-grav)*mass);}double _powerScale=1;IMyTerminalBlock _aimRef{get{return _rc;}}void ApplyThrust(Vector3D f){_tvN=f;_rc.DampenersOverride=false;MatrixD m=_rc.WorldMatrix;
double[]comp={Vector3D.Dot(f,m.Forward),-Vector3D.Dot(f,m.Forward),-Vector3D.Dot(f,m.Right),Vector3D.Dot(f,m.Right),Vector3D.Dot(f,m.Up),-Vector3D.Dot(f,m.Up)};for(int i=0;i&lt;6;i++){double max=0;foreach(var t in _thrDir[i])if(t.IsWorking)max+=t.MaxEffectiveThrust;float pct=(comp[i]&gt;0&amp;&amp;max&gt;0)?(float)MathHelper.Clamp(comp[i]/max,0,1):0f;foreach(var t in _thrDir[i])t.ThrustOverridePercentage=pct;}}Vector3D _prevErr;void Aim(Vector3D fwd){Vector3D tvU=Vector3D.Zero,tvF=Vector3D.Zero;TvAim(ref fwd,ref tvU,ref tvF);MatrixD refM=_rc.WorldMatrix;Vector3D d=Vector3D.Normalize(Vector3D.TransformNormal(fwd,MatrixD.Transpose(refM)));
