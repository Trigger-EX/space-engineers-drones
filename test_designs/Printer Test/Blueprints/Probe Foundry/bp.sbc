g.GyroOverride=true;}}void Release(){foreach(var g in _gyros){g.GyroOverride=false;g.Pitch=g.Yaw=g.Roll=0;}foreach(var t in _thr)t.ThrustOverridePercentage=0;if(_rc!=null)_rc.DampenersOverride=true;}void Rest(){}double CycleLen(int i){return Cycle[i]==0?PowerSec:GroupSec;}void Sample(Vector3D tp){if(_tur.Count==0){_log="no turret";return;}if(_now-_cycT&gt;CycleLen(_cyc)){_cyc=(_cyc+1)%Cycle.Length;_cycT=_now;}_want=Cycle[_cyc];string wg=Groups[_want];foreach(var tu in _tur){if(!tu.IsFunctional){_log="turret damaged";continue;}string cur;try{cur=tu.GetTargetingGroup();}catch(Exception){cur="";}if(cur!=wg){
try{tu.SetTargetingGroup(wg);_swT=_now;}catch(Exception x){_log="group not set: "+x.Message;}continue;}if(_now-_swT&lt;SettleSec||_now-_lastSample&lt;0.4)continue;if(!tu.HasTarget){_log=wg+": turret has no target";continue;}if(!tu.IsAimed){_log=wg+": turret turning";continue;}var te=tu.GetTargetedEntity();if(te.EntityId!=_tid){_log=wg+": turret on another target";continue;}Vector3D o=tu.GetPosition(),q;bool hp=te.HitPosition.HasValue&amp;&amp;(te.HitPosition.Value-te.Position).LengthSquared()&gt;1;if(hp)q=te.HitPosition.Value;else{Vector3D d;Vector3D.CreateFromAzimuthAndElevation(tu.Azimuth,tu.Elevation,out d);
d=Vector3D.TransformNormal(d,tu.WorldMatrix);double D=Vector3D.Dot(tp-o,d);if(D&lt;5){_log=wg+": turret points away";continue;}q=o+d*D;if(LeadSpeed&gt;1){Vector3D rv=_tVel-_rc.GetShipVelocities().LinearVelocity;q-=rv*(D/LeadSpeed);}}IMyCameraBlock cam=null;foreach(var c in _cams){if(!c.IsFunctional)continue;Vector3D cd0=q-c.GetPosition();if(cd0.LengthSquared()&lt;1)continue;if(Vector3D.Dot(Vector3D.Normalize(cd0),c.WorldMatrix.Forward)&lt;0.7)continue;if(c.CanScan(cd0.Length()+RayPast)){cam=c;break;}}if(cam==null){_log=wg+": no camera can reach";continue;}Vector3D cd=q-cam.GetPosition();double cl=cd.Length();
cd/=cl;var e=cam.Raycast(q+cd*RayPast);if(e.IsEmpty()||e.EntityId!=_tid|| !e.HitPosition.HasValue){_log=wg+": ray missed hull";continue;}MatrixD inv=MatrixD.Transpose(e.Orientation);Vector3D local=Vector3D.TransformNormal(e.HitPosition.Value-e.Position,inv);Vector3D dir=Vector3D.TransformNormal(cd,inv);IGC.SendBroadcastMessage(HostTag+"_CRIT",new MyTuple&lt;long,int,Vector3D,Vector3D,long&gt;(_tid,_want,local,dir,Me.CubeGrid.EntityId));_lastSample=_now;_sent++;_perGroup[_want]++;_log=wg+": "+(hp?"block pos":"aim line")+", "+(q-e.HitPosition.Value).Length().ToString("0")+" m under hull";}}void Beat(){
Vector3D v=_rc!=null?_rc.GetShipVelocities().LinearVelocity:Vector3D.Zero;IGC.SendBroadcastMessage(Tag+"_SWARM",new MyTuple&lt;long,Vector3D,Vector3D,long,int&gt;(Me.CubeGrid.EntityId,Me.GetPosition(),v,_tid,0));}void Display(){_sb.Clear();_sb.Append("PEEPER v").Append(VER).Append("  ").Append(_mode).Append('\n');_sb.Append("Host ").Append(HostTag).Append("  tgt ").Append(_haveTgt?((TgtPos()-Me.GetPosition()).Length().ToString("0")+" m r "+_tRad.ToString("0")):"none").Append('\n');_sb.Append("Group ").Append(Groups[_want]).Append('\n');_sb.Append("Reports ").Append(_sent).Append("  P").Append(_perGroup[0]).Append(" W").Append(_perGroup[1]).Append(" R").Append(_perGroup[2]).Append('\n');
_sb.Append(_log).Append('\n');_sb.Append("Thr ").Append(_thr.Count).Append(" Cam ").Append(_cams.Count).Append(" Tur ").Append(_tur.Count).Append('\n');_sb.Append("Ins ").Append(Runtime.CurrentInstructionCount).Append('/').Append(Runtime.MaxInstructionCount).Append('\n');if(_err!="")_sb.Append("! ").Append(_err).Append('\n');string s=_sb.ToString();_lcd.WriteText(s);Echo(s);}
