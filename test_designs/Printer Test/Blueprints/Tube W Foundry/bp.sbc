List&lt;ErrRec&gt;_errs=new List&lt;ErrRec&gt;();public Program(){Runtime.UpdateFrequency=UpdateFrequency.Update10;_where="constructor LoadConfig";try{LoadConfig();}catch(Exception ex){Err(ex,null);}_where="constructor GetBlocks";try{GetBlocks();}catch(Exception ex){Err(ex,null);}_where="constructor listeners";try{if(RackMode)foreach(var t in TargetTags.Split(','))if(t.Trim()!="")_lTgt.Add(IGC.RegisterBroadcastListener(t.Trim()+"_TGT"));}catch(Exception ex){Err(ex,null);}try{Show();Echo(_screen);}catch(Exception){}}void Err(Exception ex,Bay b){string frame="";try{string st=ex.ToString();if(st!=null){string f=null;
foreach(var ln in st.Split('\n'))if(ln.IndexOf("Program.",StringComparison.Ordinal)&gt;=0){f=ln.Trim();break;}if(f==null){int nl=st.IndexOf('\n');f=(nl&gt;0?st.Substring(0,nl):st).Trim();}int pr=f.IndexOf('(');if(pr&gt;0)f=f.Substring(0,pr);if(f.StartsWith("at "))f=f.Substring(3);if(f.Length&gt;50)f=f.Substring(f.Length-50);frame=f;}}catch(Exception){}string text=ex.GetType().FullName+": "+ex.Message+" | at: "+_where+(b!=null?" | bay "+b.N+" state "+b.State:"")+(frame!=""?" | in "+frame:"");_errTotal++;if(_errs.Count&gt;0&amp;&amp;_errs[_errs.Count-1].Text==text){_errs[_errs.Count-1].N++;_errs[_errs.Count-1].Last=_now;
}else{_errs.Add(new ErrRec{Text=text,T=_now,Last=_now});if(_errs.Count&gt;3)_errs.RemoveAt(0);}try{Echo("ERROR "+text);}catch(Exception){}}string ErrText(){if(_errs.Count==0)return"";var sb=new StringBuilder("ERRORS ("+_errTotal+" total, last 3):\n");foreach(var e in _errs)sb.Append(" t=").Append((int)e.T).Append("s").Append(e.N&gt;1?" x"+e.N+" until t="+(int)e.Last+"s":"").Append(": ").Append(e.Text).Append('\n');return sb.ToString();}void BayFail(Bay b,Exception ex){Err(ex,b);try{if(b.State!="FAULT"){b.State="FAULT";b.T=_now;b.Faults++;}b.Msg="EXCEPTION "+ex.GetType().FullName+": "+ex.Message+" (at "+_where+")";
b.KickW=null;}catch(Exception){}}bool Gone(IMyTerminalBlock x){if(x==null)return true;try{return GridTerminalSystem.GetBlockWithId(x.EntityId)==null;}catch(Exception){return true;}}bool SetOn(IMyFunctionalBlock x,bool on){if(x==null||_dead.Contains(x))return false;try{if(x.Enabled!=on)x.Enabled=on;return true;}catch(Exception ex){_dead.Add(x);Err(ex,null);return false;}}bool Projecting(Bay b){try{return b.Proj!=null&amp;&amp;b.Proj.IsProjecting;}catch(Exception ex){b.ProjErr=ex.GetType().FullName+" reading IsProjecting";Err(ex,b);return false;}}int RemainingOf(Bay b){try{return b.Proj.RemainingBlocks;}
catch(Exception ex){b.ProjErr=ex.GetType().FullName+" reading RemainingBlocks";Err(ex,b);return-1;}}int TotalOf(Bay b){try{return b.Proj.TotalBlocks;}catch(Exception ex){b.ProjErr=ex.GetType().FullName+" reading TotalBlocks";Err(ex,b);return-1;}}int BuildableOf(Bay b){try{return b.Proj.BuildableBlocksCount;}catch(Exception ex){b.ProjErr=ex.GetType().FullName+" reading BuildableBlocksCount";Err(ex,b);return-1;}}int RemNow(Bay b){return Projecting(b)?Math.Max(-1,RemainingOf(b)): -1;}void LoadConfig(){MyIniParseResult r;if(!_ini.TryParse(Me.CustomData??"",out r))return;const string S="Hive Mother";
MaxDrones=(int)C(S,"Max Drones (all tags)",MaxDrones);RackMode=C(S,"Rack Mode",RackMode);LaunchTag=C(S,"Rack Launch Command Tag",LaunchTag);TargetTags=C(S,"Rack Target Tags (enemy sightings that release a drone)",TargetTags);ChargeSeconds=C(S,"Max Charge Seconds",ChargeSeconds);CooldownSeconds=C(S,"Cooldown Seconds",CooldownSeconds);WeldersStayOn=C(S,"Welders Stay On Through Release",WeldersStayOn);StallSeconds=C(S,"Stall Warning Seconds",StallSeconds);BuildTimeout=C(S,"Build Timeout Seconds",BuildTimeout);FaultSeconds=C(S,"Fault Retry Seconds",FaultSeconds);ParallelBuilds=(int)C(S,"Parallel Builds",ParallelBuilds);
DoRecompile=C(S,"Recompile Drone PB Before Release",DoRecompile);RecompileWait=C(S,"Recompile Wait Seconds",RecompileWait);NudgeSeconds=C(S,"Release Nudge Seconds",NudgeSeconds);NudgePower=C(S,"Release Nudge Power (0-1)",NudgePower);GapSeconds=C(S,"Release Gap Seconds",GapSeconds);MatchRadius=C(S,"Drone Match Radius m",MatchRadius);FinishTimeout=C(S,"Finish Timeout Seconds",FinishTimeout);ArmourSettle=C(S,"Armour Settle Seconds",ArmourSettle);FinishFallback=C(S,"Finish Fallback Seconds (used only without Drone Box keys)",FinishFallback);ArmSeconds=C(S,"Arm Max Seconds",ArmSeconds);JoinSeconds=Math.Max(30,C(S,"Join Seconds",JoinSeconds));
FusedGrace=C(S,"Fused Grace Seconds",FusedGrace);LaunchBurst=C(S,"Launch Burst Seconds",LaunchBurst);string fch=C(S,"Fleet Channel",FleetCh).Trim();string fsec=C(S,"Fleet Secret","").Trim();FleetCh=fch==""?"":(fsec==""?fch.ToUpperInvariant():fch.ToUpperInvariant()+"_"+fsec.ToUpperInvariant());Relay=C(S,"Relay Turret Targets To All Tags",Relay);Printing=C(S,"Auto Start",Printing);string o=_ini.ToString();if(o!=Me.CustomData)Me.CustomData=o;}void SetHold(Bay b,bool v){b.Held=v;try{MyIniParseResult r;if(_ini.TryParse(Me.CustomData??"",out r)){_ini.Set("Bay "+b.N,"Hold",v);string o=_ini.ToString();
if(o!=Me.CustomData)Me.CustomData=o;}}catch(Exception ex){Err(ex,b);}}string C(string s,string k,string d){if(!_ini.ContainsKey(s,k))_ini.Set(s,k,d);return _ini.Get(s,k).ToString(d);}double C(string s,string k,double d){if(!_ini.ContainsKey(s,k))_ini.Set(s,k,d);return _ini.Get(s,k).ToDouble(d);}bool C(string s,string k,bool d){if(!_ini.ContainsKey(s,k))_ini.Set(s,k,d);return _ini.Get(s,k).ToBoolean(d);}void GetBlocks(){_dead.Clear();var old=_bays;var nb=new List&lt;Bay&gt;();var projs=new List&lt;IMyProjector&gt;();var welders=new List&lt;IMyShipWelder&gt;();var merges=new List&lt;IMyShipMergeBlock&gt;();var timers=new List&lt;IMyTimerBlock&gt;();
_where="GetBlocks find bay blocks";GridTerminalSystem.GetBlocksOfType(projs,b=&gt;b!=null&amp;&amp;b.IsSameConstructAs(Me)&amp;&amp;b.CustomName.Contains("[Bay"));GridTerminalSystem.GetBlocksOfType(welders,b=&gt;b!=null&amp;&amp;b.IsSameConstructAs(Me)&amp;&amp;b.CustomName.Contains("[Bay"));GridTerminalSystem.GetBlocksOfType(merges,b=&gt;b!=null&amp;&amp;b.IsSameConstructAs(Me)&amp;&amp;b.CustomName.Contains("[Bay"));GridTerminalSystem.GetBlocksOfType(timers,b=&gt;b!=null&amp;&amp;b.IsSameConstructAs(Me)&amp;&amp;b.CustomName.Contains("[Bay"));_cap.Clear();MyIniParseResult r;bool iniOk=_ini.TryParse(Me.CustomData??"",out r);for(int n=1;n&lt;=MaxBays;n++){string tag="[Bay "+n+"]";
string sec="Bay "+n;Bay bay=null;foreach(var o in old)if(o.N==n)bay=o;if(bay==null)bay=new Bay{N=n};_where="GetBlocks bay "+n+" assign blocks";var oldProj=bay.Proj;var oldMerge=bay.Merge;bay.Proj=null;bay.Merge=null;bay.Welders.Clear();bay.Timers.Clear();foreach(var p in projs)if(p.CustomName.Contains(tag))bay.Proj=p;foreach(var m in merges)if(m.CustomName.Contains(tag))bay.Merge=m;foreach(var w in welders)if(w.CustomName.Contains(tag))bay.Welders.Add(w);foreach(var tm in timers)if(tm.CustomName.Contains(tag))bay.Timers.Add(tm);if(bay.Proj==null||bay.Merge==null)continue;if((oldProj!=null&amp;&amp;oldProj!=bay.Proj)||(oldMerge!=null&amp;&amp;oldMerge!=bay.Merge)){
bay.DPb=null;bay.DMerge=null;bay.DBats.Clear();bay.KickW=null;}if(bay.KickW!=null&amp;&amp; !bay.Welders.Contains(bay.KickW))bay.KickW=null;bay.ProjErr="";_where="GetBlocks bay "+n+" config";if(iniOk)try{bay.Tag=C(sec,"Tag",bay.Tag);bay.Prefix=C(sec,"Prefix",bay.Prefix);bay.Cap=(int)C(sec,"Max Alive",bay.Cap);bay.MaxPrints=(int)C(sec,"Max Prints",bay.MaxPrints);bool held=C(sec,"Hold",bay.Held);bay.Held=held;string exl=C(sec,"Exit Direction",bay.Exit);bay.Exit=exl;bay.SkipFinish=C(sec,"Skip Finish Check",false);bay.Burst=C(sec,"Launch Burst Seconds",LaunchBurst);bay.Cells=(int)C(sec,"Drone Cell Count",0.0);
bay.Tol=(int)C(sec,"Drone Cell Tolerance",2.0);string bmin=C(sec,"Drone Box Min","").Trim(),bmax=C(sec,"Drone Box Max","").Trim(),ign=C(sec,"Ignore Cells","").Trim();ParseBox(bay,bmin,bmax,ign);}catch(Exception ex){Err(ex,bay);bay.CfgWarn="config error: "+ex.Message;}nb.Add(bay);int c;if(!_cap.TryGetValue(bay.Tag,out c)||bay.Cap&gt;c)_cap[bay.Tag]=bay.Cap;if(!_lSwarm.ContainsKey(bay.Tag)|| !_alive.ContainsKey(bay.Tag)){_lSwarm[bay.Tag]=IGC.RegisterBroadcastListener(bay.Tag+"_SWARM");_alive[bay.Tag]=new Dictionary&lt;long,double&gt;();_joinUntil[bay.Tag]=0;_joinNext[bay.Tag]=0;}}_bays=nb;_where="GetBlocks save config";
if(iniOk){string o=_ini.ToString();if(o!=Me.CustomData)Me.CustomData=o;}_where="GetBlocks KeepProjection";foreach(var b2 in _bays)KeepProjection(b2);_where="GetBlocks stock/thrusters";GridTerminalSystem.GetBlocksOfType(_stock,b=&gt;b!=null&amp;&amp;b.CustomName.Contains("[Stock]")&amp;&amp;b.IsSameConstructAs(Me));GridTerminalSystem.GetBlocksOfType(_thr,b=&gt;b!=null&amp;&amp;b.IsSameConstructAs(Me)&amp;&amp;b.CubeGrid==Me.CubeGrid);if(Relay){_where="GetBlocks turrets";GridTerminalSystem.GetBlocksOfType(_turrets,b=&gt;b!=null&amp;&amp;b.IsSameConstructAs(Me));GridTerminalSystem.GetBlocksOfType(_ctcs,b=&gt;b!=null&amp;&amp;b.IsSameConstructAs(Me));}_where="GetBlocks LCD surface";
IMyTextSurface sf=null;try{if(Me.SurfaceCount&gt;0)sf=Me.GetSurface(0);}catch(Exception ex){Err(ex,null);}if(sf!=null){_lcd=sf;try{_lcd.ContentType=ContentType.TEXT_AND_IMAGE;_lcd.FontSize=0.7f;}catch(Exception ex){Err(ex,null);}}}void KeepProjection(Bay b){if(b==null||b.Proj==null)return;try{if(!b.Proj.GetValue&lt;bool&gt;("KeepProjection"))b.Proj.SetValue&lt;bool&gt;("KeepProjection",true);}catch(Exception){}}static long Key(int x,int y,int z){return((long)(x+1048576)&lt;&lt;42)|((long)(y+1048576)&lt;&lt;21)|(long)(z+1048576);}static bool ParseV3(string s,out int x,out int y,out int z){x=y=z=0;var p=s.Split(',');return p.Length==3&amp;&amp;int.TryParse(p[0].Trim(),out x)&amp;&amp;int.TryParse(p[1].Trim(),out y)&amp;&amp;int.TryParse(p[2].Trim(),out z);
}void ParseBox(Bay b,string bmin,string bmax,string ign){string raw=bmin+"|"+bmax+"|"+ign;if(raw==b.BoxRaw)return;b.BoxRaw=raw;b.HasBox=false;b.CfgWarn="";b.Ignore.Clear();b.ScanIdx=0;b.Seen.Clear();int x0,y0,z0,x1,y1,z1;if(bmin==""&amp;&amp;bmax=="")return;if(!ParseV3(bmin,out x0,out y0,out z0)|| !ParseV3(bmax,out x1,out y1,out z1)){b.CfgWarn="Drone Box keys unreadable (use x,y,z)";return;}int ax=Math.Min(x0,x1),ay=Math.Min(y0,y1),az=Math.Min(z0,z1),bx=Math.Max(x0,x1),by=Math.Max(y0,y1),bz=Math.Max(z0,z1);long vol=(long)(bx-ax+1)*(by-ay+1)*(bz-az+1);if(vol&gt;200000){b.CfgWarn="Drone Box too large ("+vol+" cells)";
