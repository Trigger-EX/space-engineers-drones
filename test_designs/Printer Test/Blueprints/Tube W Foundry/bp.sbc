b.DPb=null;bd=1e9;int br=9;foreach(var p in _pbs){try{Vector3D q=p.GetPosition();double d=Vector3D.Distance(q,mp);int r=p.CustomName.StartsWith("[Staff]")?0:p.CustomName.StartsWith("[Flight]")?1:2;if((r&lt;br||(r==br&amp;&amp;d&lt;bd))&amp;&amp;Nearest(q)==b){br=r;bd=d;b.DPb=p;}}catch(Exception){}}GridTerminalSystem.GetBlocksOfType(_bats,x=&gt;x!=null&amp;&amp;x.CustomName.StartsWith(b.Prefix)&amp;&amp; !x.CustomName.Contains("[Bay"));b.DBats.Clear();foreach(var x in _bats){try{if(Nearest(x.GetPosition())==b)b.DBats.Add(x);}catch(Exception){}}}bool DroneCharged(Bay b){if(b.DBats.Count==0)return true;foreach(var x in b.DBats){try{if(x.CurrentStoredPower&lt;x.MaxStoredPower*0.95f)return false;
}catch(Exception){}}return true;}void Release(Bay b){Power(b,StayOn());FindDrone(b);b.Away=Vector3D.Zero;if(b.DMerge!=null){try{Vector3D d=b.DMerge.GetPosition()-b.Merge.GetPosition();if(d.LengthSquared()&gt;1e-6)b.Away= -Vector3D.Normalize(d);}catch(Exception ex){Err(ex,b);b.DMerge=null;}}if(!string.IsNullOrEmpty(b.Exit)){MatrixD g=Me.CubeGrid.WorldMatrix;Vector3D ex=Vector3D.Zero;switch(b.Exit.Trim()){case"Forward":ex=g.Forward;break;case"Backward":ex=g.Backward;break;case"Up":ex=g.Up;break;case"Down":ex=g.Down;break;case"Left":ex=g.Left;break;case"Right":ex=g.Right;break;}if(ex.LengthSquared()&gt;0.5)b.Away= -ex;
}b.RackLaunch=RackMode;b.Armed=false;b.LaunchWritten=false;b.FusedT=0;b.Msg="";b.State="ARM";b.T=_now;b.Nudged=false;}bool StillAttached(Bay b){if(b.DPb==null&amp;&amp;b.DMerge==null)return false;try{var g=b.Merge.CubeGrid;if(g==null)return false;return(b.DPb==null||b.DPb.CubeGrid==g)&amp;&amp;(b.DMerge==null||b.DMerge.CubeGrid==g);}catch(Exception ex){Err(ex,b);return false;}}bool Arm(Bay b){FindDrone(b);if(b.DPb==null){b.Ai.Clear();GridTerminalSystem.GetBlocksOfType(_tmp,x=&gt;x!=null&amp;&amp;x.CustomName.StartsWith(b.Prefix)&amp;&amp; !x.CustomName.Contains("[Bay")&amp;&amp;x.CubeGrid==b.Merge.CubeGrid&amp;&amp;(x.BlockDefinition.TypeIdString.Contains("FlightMovement")||x.BlockDefinition.TypeIdString.Contains("CombatBlock"))&amp;&amp;Nearest(x.GetPosition())==b);
b.Ai.AddRange(_tmp);b.Msg=b.Ai.Count&gt;0?"":"ARM: drone PB not visible - relying on the JOIN broadcast";return b.Ai.Count&gt;0;}try{if(!b.LaunchWritten){b.LaunchWritten=true;_where="bay "+b.N+" ARM write drone Custom Data";var ini=new MyIni();MyIniParseResult r;if(ini.TryParse(b.DPb.CustomData??"",out r)){ini.Set("Launch","Auto",!RackMode);ini.Set("Launch","Burst Seconds",b.Burst&gt;=0?b.Burst:LaunchBurst);Vector3D da= -b.Away;ini.Set("Launch","Away X",da.X);ini.Set("Launch","Away Y",da.Y);ini.Set("Launch","Away Z",da.Z);ini.Set("Launch","Exit Direction",b.Exit==null?"":b.Exit.Trim());ini.Set("Launch","Armed",true);
b.DPb.CustomData=ini.ToString();}else b.Msg="ARM: drone Custom Data unreadable - relying on the JOIN broadcast";}_where="bay "+b.N+" ARM run drone PB";b.DPb.Enabled=true;bool ok=b.DPb.TryRun("armed");if(!ok)b.Msg="ARM: drone PB did not run (TryRun false: not compiled or not working yet?) - relying on the JOIN broadcast";else b.Msg="";return ok;}catch(Exception ex){Err(ex,b);b.Msg="ARM failed ("+ex.GetType().FullName+") - relying on the JOIN broadcast";b.DPb=null;return false;}}void Separate(Bay b){_where="bay "+b.N+" Separate batteries";foreach(var x in b.DBats){try{if(x.ChargeMode!=ChargeMode.Auto)x.ChargeMode=ChargeMode.Auto;
}catch(Exception ex){Err(ex,b);}}_where="bay "+b.N+" Separate merge blocks off";SetOn(b.Merge,false);SetOn(b.DMerge,false);foreach(var x in b.Ai){try{x.ApplyAction("OnOff_On");x.ApplyAction("ActivateBehavior_On");}catch(Exception ex){Err(ex,b);}}b.Ai.Clear();b.State="RELEASE";b.T=_now;b.Nudged=false;b.Printed++;}void Nudge(Bay b,double t){if(b.Away.LengthSquared()&lt;0.5)return;bool on=t&lt;NudgeSeconds;if(!on&amp;&amp; !b.Nudged)return;foreach(var th in _thr){try{if(th.CustomName.StartsWith(b.Prefix))continue;if(Vector3D.Dot(th.WorldMatrix.Backward,b.Away)&gt;0.85)th.ThrustOverridePercentage=on?(float)NudgePower:0f;
}catch(Exception){}}b.Nudged=on;}void RelayTargets(){foreach(var t in _turrets){try{if(t.IsFunctional&amp;&amp;t.HasTarget)SendTarget(t.GetTargetedEntity());}catch(Exception){}}foreach(var c in _ctcs){try{if(c.IsFunctional&amp;&amp;c.HasTarget)SendTarget(c.GetTargetedEntity());}catch(Exception){}}}void SendTarget(MyDetectedEntityInfo e){if(e.IsEmpty()||e.Relationship!=MyRelationsBetweenPlayerAndBlock.Enemies)return;var msg=new MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;(e.EntityId,e.Position,new Vector3D(e.Velocity),e.BoundingBox.Size.Length()*0.5,Me.EntityId);foreach(var tag in _lSwarm.Keys)IGC.SendBroadcastMessage(tag+"_TGT",msg);
}void Command(string a){var w=a.Split(' ');int n;switch(w[0]){case"start":Printing=true;break;case"stop":Printing=false;foreach(var b in _bays){try{Power(b,false);}catch(Exception ex){Err(ex,b);}}break;case"max":if(w.Length&gt;1&amp;&amp;int.TryParse(w[1],out n))MaxDrones=n;break;case"release":foreach(var b in _bays)if((b.State=="DOCKED"||b.State=="CHARGE")&amp;&amp;(w.Length&lt;2||(int.TryParse(w[1],out n)&amp;&amp;n==b.N)))Release(b);break;case"hold":if(w.Length&gt;1&amp;&amp;int.TryParse(w[1],out n))foreach(var b in _bays)if(b.N==n)SetHold(b,true);break;case"unhold":if(w.Length&gt;1&amp;&amp;int.TryParse(w[1],out n))foreach(var b in _bays)if(b.N==n){
SetHold(b,false);if(b.State=="FAULT")b.State="IDLE";}break;case"relay":Relay=w.Length&lt;2||w[1]!="off";break;case"reload":LoadConfig();GetBlocks();_errs.Clear();_errTotal=0;foreach(var b in _bays)b.Printed=0;break;}}void Show(){int docked=0;foreach(var d0 in _bays)if(d0.State=="DOCKED")docked++;_sb.Clear();_sb.Append("HIVE MOTHER v").Append(VER).Append(Printing?"  PRINTING":"  STOPPED");if(_errs.Count&gt;0)_sb.Append("   !! ").Append(_errTotal).Append(" ERROR").Append(_errTotal==1?"":"S");_sb.Append('\n');if(RackMode)_sb.Append("Rack: ").Append(docked).Append(" docked, targets ").Append(_targets.Count).Append('\n');
else _sb.Append("Drones alive: ").Append(AliveAll()).Append(" / ").Append(MaxDrones).Append("   building ").Append(PendingAll()).Append('\n');foreach(var b in _bays){try{_sb.Append("Bay ").Append(b.N).Append(' ').Append(b.Tag).Append(": ").Append(b.State);if(b.Printed&gt;0)_sb.Append(" #").Append(b.Printed);if(b.Held)_sb.Append(" (held)");if(b.State=="BUILD")_sb.Append("  ").Append(b.Rem&gt;=0?b.Rem+" left":"no projection");if(b.State=="FINISH"){long tot=b.HasBox?(long)(b.BMax.X-b.BMin.X+1)*(b.BMax.Y-b.BMin.Y+1)*(b.BMax.Z-b.BMin.Z+1):0;_sb.Append("  ").Append(b.HasBox?"scan "+(tot&gt;0?100*b.ScanIdx/tot:0)+"%":"name check").Append(b.HavePass?", "+b.LBad+" unfinished":"").Append(", ").Append((int)(_now-b.FinishT)).Append(" s");
}if(b.Msg!="")_sb.Append("\n   ").Append(b.Msg);}catch(Exception ex){_sb.Append("(display error ").Append(ex.GetType().FullName).Append(')');Err(ex,b);}_sb.Append('\n');}if(_bays.Count==0)_sb.Append("No bays: name a projector, welders and\na merge block with [Bay 1]\n");_sb.Append(ErrText());int ins=0,max=0;try{ins=Runtime.CurrentInstructionCount;max=Runtime.MaxInstructionCount;}catch(Exception){}_sb.Append("Ins: ").Append(ins).Append(" / ").Append(max).Append("  peak ").Append(_peakIns).Append('\n');_screen=_sb.ToString();if(_lcd!=null){try{_lcd.WriteText(_screen);}catch(Exception){}}}
</Program>
