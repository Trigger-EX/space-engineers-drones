}else _slowT=0;if(_now-_modeT&gt;20&amp;&amp;closing&lt;0){SetMode(Mode.HUNT);}}_status=(_mode==Mode.TERM?"TERM ":"HUNT ")+dist.ToString("0")+" m  tgo "+tgo.ToString("0.0")+"s  rams "+_rams;}List&lt;IMyFunctionalBlock&gt;_ai=new List&lt;IMyFunctionalBlock&gt;();bool _aiOn=false;int _aiScan=0;double _aiSince= -99;bool UnderFire{get{return false;}}bool IsAiBlock(IMyTerminalBlock b){if(!Mine(b))return false;if(b.CustomName.Contains("[AI]"))return true;string d=b.BlockDefinition.ToString();return d.Contains("OffensiveCombat")||d.Contains("FlightMovement");}void FindAi(){GridTerminalSystem.GetBlocksOfType(_ai,b=&gt;IsAiBlock(b));
foreach(var b in _ai)b.Enabled=_aiOn;AiGateFind(_ai);}void AiOff(){_aiOn=false;_agT0= -1;foreach(var b in _ai)b.Enabled=false;}void Search(double dt){if(_tgt==null)_tgt=Nearest();if(_tgt!=null){AiOff();foreach(var g in _gyros)g.GyroOverride=false;_launchPos=_rc.GetPosition();_slowT=0;SetMode(Mode.HUNT);return;}bool want=AiGate(_ai.Count&gt;0);if(want!=_aiOn){_aiOn=want;if(want){Release();_aiSince=_now;}foreach(var b in _ai)b.Enabled=want;}else if(_aiOn){foreach(var b in _ai)if(!b.Enabled)b.Enabled=true;if(AiRepick&gt;0&amp;&amp;_now-_aiSince&gt;AiRepick&amp;&amp;_now-_fcT&lt;60){foreach(var b in _ai)b.Enabled=false;_aiSince=_now;
return;}}if(!_aiOn){foreach(var t in _thr)t.ThrustOverridePercentage=0;foreach(var gy in _gyros){gy.GyroOverride=true;gy.Pitch=0;gy.Roll=0;gy.Yaw=0.6f;}}bool longCam=true;foreach(var c in _cams){if(!c.IsWorking||Vector3D.Dot(c.WorldMatrix.Forward,_rc.WorldMatrix.Forward)&lt;0.9)continue;double len=longCam?AiConfirmLong:AiConfirmRange;longCam=false;if(c.AvailableScanRange&lt;len)continue;_aiScan++;double r=0,th=_aiScan*2.39996323;if((_aiScan&amp;1)==1){int j=(_aiScan&gt;&gt;1)%16;r=0.15+2.35*Math.Pow((j+0.5)/16.0,1.5);}var e=c.Raycast(len,(float)(r*Math.Sin(th)),(float)(r*Math.Cos(th)));if(Valid(e))Add(e.EntityId,e.Position,new Vector3D(e.Velocity),e.BoundingBox.Size.Length()/2,"AI");
}_status="SEARCH "+(_aiOn?"AI flying":"script spin")+"  contacts "+_contacts.Count;}void Extend(double dt){if(_tgt==null){Release();SetMode(Mode.WAIT);return;}Vector3D me=_rc.GetPosition(),myVel=_rc.GetShipVelocities().LinearVelocity,g=_rc.GetNaturalGravity();Vector3D rel=me-_tgt.Pos;double dist=rel.Length();double fmax=0;foreach(var t in _fwd)if(t.IsWorking)fmax+=t.MaxEffectiveThrust;double mass=_rc.CalculateShipMass().PhysicalMass,amax=fmax&gt;0?fmax/mass:1;double run=RunUp&gt;0?RunUp:MathHelper.Clamp(1.3*MaxSpeed*MaxSpeed/(2*amax),200,800);if(dist&gt;run||_now-_modeT&gt;10){SetMode(Mode.HUNT);return;}Vector3D away=dist&gt;1?rel/dist: -_rc.WorldMatrix.Forward;
