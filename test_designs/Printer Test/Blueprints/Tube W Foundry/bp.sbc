List&lt;IMyBroadcastListener&gt;_flAll=new List&lt;IMyBroadcastListener&gt;();List&lt;string&gt;_flOut=new List&lt;string&gt;();string _flKey="",_flChan="";string _flAllowed="hunt,attack,guard,ready,follow,escort,form,assist,rtb,idle,stop,launch,abort,split,focus,next,unlock,aialert";bool _flCmdOn=true,_flHomeOn=true;string FleetTag(string t,string ch){t=t.Trim();if(t.Length==0)return"";if(t.ToUpperInvariant()=="FLEET")return ch==""?"":ch+"_TGT";return t.IndexOf('_')&gt;=0?t:t.ToUpperInvariant()+"_TGT";}void FleetLoad(bool listen){var ini=new MyIni();MyIniParseResult res;if(!ini.TryParse(Me.CustomData,out res))return;const string S="Fleet";
if(!ini.ContainsKey(S,"Channel"))ini.Set(S,"Channel","FLEET");if(!ini.ContainsKey(S,"Secret"))ini.Set(S,"Secret","");if(!ini.ContainsKey(S,"Listen Tags"))ini.Set(S,"Listen Tags","");if(!ini.ContainsKey(S,"Extra Broadcast Tags"))ini.Set(S,"Extra Broadcast Tags","FLEET");if(!ini.ContainsKey(S,"Accept Commands"))ini.Set(S,"Accept Commands",true);if(!ini.ContainsKey(S,"Allowed Commands"))ini.Set(S,"Allowed Commands",_flAllowed);if(!ini.ContainsKey(S,"Accept Home"))ini.Set(S,"Accept Home",true);string o=ini.ToString();if(o!=Me.CustomData)Me.CustomData=o;string ch=ini.Get(S,"Channel").ToString("FLEET").Trim().ToUpperInvariant().Replace(" ","");
string sec=ini.Get(S,"Secret").ToString("").Trim().Replace(" ","");if(ch!=""&amp;&amp;sec!="")ch=ch+"_"+sec;_flChan=ch;_flCmdOn=ini.Get(S,"Accept Commands").ToBoolean(true);_flHomeOn=ini.Get(S,"Accept Home").ToBoolean(true);_flAllowed=ini.Get(S,"Allowed Commands").ToString(_flAllowed).ToLowerInvariant();var tin=new List&lt;string&gt;();var tout=new List&lt;string&gt;();if(ch!="")tin.Add(ch+"_TGT");foreach(var t in ini.Get(S,"Listen Tags").ToString("").Split(',')){string x=FleetTag(t,ch);if(x!=""&amp;&amp; !tin.Contains(x))tin.Add(x);}foreach(var t in ini.Get(S,"Extra Broadcast Tags").ToString("FLEET").Split(',')){string x=FleetTag(t,ch);
if(x!=""&amp;&amp; !tout.Contains(x))tout.Add(x);}_flOut=tout;string key=string.Join("|",tin.ToArray())+"#"+ch+"#"+(listen?"1":"0");if(key==_flKey)return;_flKey=key;foreach(var l in _flAll)IGC.DisableBroadcastListener(l);_flAll.Clear();FleetTgtL.Clear();_flCmd=null;_flHome=null;if(!listen)return;foreach(var x in tin){var l=IGC.RegisterBroadcastListener(x);_flAll.Add(l);FleetTgtL.Add(l);}if(ch!=""){_flCmd=IGC.RegisterBroadcastListener(ch+"_CMD");_flAll.Add(_flCmd);_flHome=IGC.RegisterBroadcastListener(ch+"_HOME");_flAll.Add(_flHome);}}bool FleetV(Vector3D v){return Math.Abs(v.X)&lt;1e9&amp;&amp;Math.Abs(v.Y)&lt;1e9&amp;&amp;Math.Abs(v.Z)&lt;1e9;
