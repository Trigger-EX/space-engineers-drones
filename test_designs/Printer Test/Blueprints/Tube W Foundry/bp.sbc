public double FusedT;public string ProjErr="";public List&lt;IMyTimerBlock&gt;Timers=new List&lt;IMyTimerBlock&gt;();public double TimerSeen= -999;}class ErrRec{public string Text;public double T,Last;public int N=1;}List&lt;Bay&gt;_bays=new List&lt;Bay&gt;();Dictionary&lt;string,IMyBroadcastListener&gt;_lSwarm=new Dictionary&lt;string,IMyBroadcastListener&gt;();Dictionary&lt;string,Dictionary&lt;long,double&gt;&gt;_alive=new Dictionary&lt;string,Dictionary&lt;long,double&gt;&gt;();Dictionary&lt;string,int&gt;_cap=new Dictionary&lt;string,int&gt;();List&lt;IMyBroadcastListener&gt;_lTgt=new List&lt;IMyBroadcastListener&gt;();string TargetTags="GNAT,HORNET,LONGBOW";Dictionary&lt;long,double&gt;_targets=new Dictionary&lt;long,double&gt;();
