_lnMsg="took off ("+_lnMsg+", "+moved.ToString("0")+" m, "+_lnT.ToString("0.0")+" s), mode "+m;if(idle&amp;&amp;m!=""&amp;&amp;m!="IDLE"){cmd("home");cmd(m.ToLowerInvariant());}return false;}bool cut=vAway&gt;=_lnSpeed;double best= -2;foreach(var t in _lnThr)if(t.IsFunctional)best=Math.Max(best,Vector3D.Dot(t.WorldMatrix.Backward,_lnDir));if(best&lt;=0.3&amp;&amp;best&gt; -0.2){Vector3D alt=Vector3D.Zero;double ab= -2;foreach(var t in _lnThr)if(t.IsFunctional){double q=Vector3D.Dot(t.WorldMatrix.Backward,_lnDir);if(q&gt;ab){ab=q;alt=t.WorldMatrix.Backward;}}if(alt.LengthSquared()&gt;0.5){_lnDir=Vector3D.Normalize(alt);_lnP0=Me.GetPosition();
best=1;_lnMsg+=", thrust axis";}}if(best&lt;0)best=0;foreach(var t in _lnThr){double c=t.IsFunctional?Vector3D.Dot(t.WorldMatrix.Backward,_lnDir):0;t.ThrustOverridePercentage=(!cut&amp;&amp;best&gt;0.3&amp;&amp;c&gt;0.15)?(float)Math.Max(0.01,c/best):0f;}foreach(var y in _lnGy){y.GyroOverride=true;y.Pitch=0;y.Yaw=0;y.Roll=0;}if(_lnCtl!=null)_lnCtl.DampenersOverride=false;return true;}bool LaunchStep(double dt,bool idle,string startMode,bool homeOk,Vector3D home,Action&lt;string&gt;cmd){_lnTick++;_lnClock+=dt;_lnHomeOk=homeOk;_lnHome=home;LnRead();if(_lnS==2)return LnBurn(dt,idle,startMode,cmd);if(_lnS==3)return false;bool changed=Me.CubeGrid!=_lnGrid;
