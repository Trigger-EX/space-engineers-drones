                      <Program>const string VER="1.0-longbow-split";string Tag="LONGBOW",StartMode="IDLE";double MaxSpeed=98,SepRange=70;enum Mode{IDLE,GUARD,HUNT,ASSIST,RTB,FOLLOW}Mode _mode=Mode.IDLE;double _now=0;long _tick=0;Vector3D _dynHome;double _dynHomeT= -99;IMyShipController _rc;IMyProgrammableBlock _fpb;IMyTextSurface _lcd;IMyCubeGrid _myGrid;List&lt;IMyGyro&gt;_gyros=new List&lt;IMyGyro&gt;();List&lt;IMyThrust&gt;_thr=new List&lt;IMyThrust&gt;();List&lt;IMyUserControllableGun&gt;_guns=new List&lt;IMyUserControllableGun&gt;();List&lt;IMySensorBlock&gt;_sensors=new List&lt;IMySensorBlock&gt;();List&lt;IMyFunctionalBlock&gt;_ai=new List&lt;IMyFunctionalBlock&gt;();List&lt;MyDetectedEntityInfo&gt;_sensed=new List&lt;MyDetectedEntityInfo&gt;();
StringBuilder _sb=new StringBuilder();string _fk="",_sig="",_lsKey="",_crash="";IMyBroadcastListener _lHome,_lCmd,_lSwarm,_lF2S,_lFlt,_lArg;int _fl,_f2sN;long _f2sTick,_tgtId;double _f2sT= -99,_aimErr,_fireWin,_aBrake=5,_relT= -99;float _batt;string _gate="";Vector3D _tgtPos;bool _down,_folBurn,_folFol;int _errRun;List&lt;IMyBroadcastListener&gt;FleetTgtL=new List&lt;IMyBroadcastListener&gt;();IMyBroadcastListener _flCmd,_flHome;List&lt;IMyBroadcastListener&gt;_flAll=new List&lt;IMyBroadcastListener&gt;();List&lt;string&gt;_flOut=new List&lt;string&gt;();string _flKey="",_flChan="";string _flAllowed="hunt,attack,guard,ready,sentry,follow,escort,form,assist,rtb,idle,stop,launch,abort,split,focus,next,unlock,aialert";
bool _flCmdOn=true,_flHomeOn=true;string FleetTag(string t,string ch){t=t.Trim();if(t.Length==0)return"";if(t.ToUpperInvariant()=="FLEET")return ch==""?"":ch+"_TGT";return t.IndexOf('_')&gt;=0?t:t.ToUpperInvariant()+"_TGT";}void FleetLoad(bool listen){var ini=new MyIni();MyIniParseResult res;if(!ini.TryParse(Me.CustomData,out res))return;const string S="Fleet";if(!ini.ContainsKey(S,"Channel"))ini.Set(S,"Channel","FLEET");if(!ini.ContainsKey(S,"Secret"))ini.Set(S,"Secret","");if(!ini.ContainsKey(S,"Listen Tags"))ini.Set(S,"Listen Tags","");if(!ini.ContainsKey(S,"Extra Broadcast Tags"))ini.Set(S,"Extra Broadcast Tags","FLEET");
if(!ini.ContainsKey(S,"Accept Commands"))ini.Set(S,"Accept Commands",true);if(!ini.ContainsKey(S,"Allowed Commands"))ini.Set(S,"Allowed Commands",_flAllowed);if(!ini.ContainsKey(S,"Accept Home"))ini.Set(S,"Accept Home",true);string o=ini.ToString();if(o!=Me.CustomData)Me.CustomData=o;string ch=ini.Get(S,"Channel").ToString("FLEET").Trim().ToUpperInvariant().Replace(" ","");string sec=ini.Get(S,"Secret").ToString("").Trim().Replace(" ","");if(ch!=""&amp;&amp;sec!="")ch=ch+"_"+sec;_flChan=ch;_flCmdOn=ini.Get(S,"Accept Commands").ToBoolean(true);_flHomeOn=ini.Get(S,"Accept Home").ToBoolean(true);_flAllowed=ini.Get(S,"Allowed Commands").ToString(_flAllowed).ToLowerInvariant();
