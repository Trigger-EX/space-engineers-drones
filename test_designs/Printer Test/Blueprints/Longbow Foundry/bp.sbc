if(sig!=_sig){_sig=sig;LoadMods();}Listen();}void LoadMods(){FleetLoad(true);LaunchLoad();FollowLoad();FoLeash=Math.Max(FoLeash,2200);}void Listen(){string k=Tag+"|"+_fk;if(k==_lsKey)return;_lsKey=k;foreach(var l in new[]{_lHome,_lCmd,_lSwarm,_lF2S,_lFlt,_lArg})if(l!=null)IGC.DisableBroadcastListener(l);_lHome=IGC.RegisterBroadcastListener(Tag+"_HOME");_lCmd=IGC.RegisterBroadcastListener(Tag+"_CMD");_lSwarm=IGC.RegisterBroadcastListener(Tag+"_SWARM");_lF2S=_fk!=""?IGC.RegisterBroadcastListener(_fk+".F2S"):null;_lFlt=_fk!=""?IGC.RegisterBroadcastListener(_fk+".FLT"):null;_lArg=_fk!=""?IGC.RegisterBroadcastListener(_fk+".CMD"):null;
