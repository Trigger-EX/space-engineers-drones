}catch(Exception ex){CtorErr("blocks",ex);}try{string m=StartMode.Trim().ToUpperInvariant();if(m=="SATELLITE"||m=="SAT"||m=="ORBIT")FoSat=true;}catch(Exception ex){CtorErr("mode",ex);}Runtime.UpdateFrequency=UpdateFrequency.Update1;}void LoadFlightCfg(){if(_fpb==null)return;var ini=new MyIni();MyIniParseResult res;if(!ini.TryParse(_fpb.CustomData,out res))return;Tag=ini.Get("Longbow","IGC Tag").ToString(Tag);StartMode=ini.Get("Longbow","Start Mode (GUARD/HUNT/ASSIST/IDLE)").ToString(StartMode);MaxSpeed=ini.Get("Longbow","Combat Speed").ToDouble(MaxSpeed);SepRange=ini.Get("Longbow","Wingmate Separation Range").ToDouble(SepRange);
}void GetBlocks(){var ctrls=new List&lt;IMyShipController&gt;();GridTerminalSystem.GetBlocksOfType(ctrls,b=&gt;b.IsSameConstructAs(Me)&amp;&amp;b.CanControlShip);_rc=null;foreach(var c in ctrls)if(c is IMyRemoteControl){_rc=c;break;}if(_rc==null&amp;&amp;ctrls.Count&gt;0)_rc=ctrls[0];var g=Me.CubeGrid;GridTerminalSystem.GetBlocksOfType(_gyros,b=&gt;b.CubeGrid==g);GridTerminalSystem.GetBlocksOfType(_thr,b=&gt;b.CubeGrid==g);GridTerminalSystem.GetBlocksOfType(_guns,b=&gt;b.CubeGrid==g&amp;&amp; !(b is IMyLargeTurretBase));GridTerminalSystem.GetBlocksOfType(_sensors,b=&gt;b.IsSameConstructAs(Me));GridTerminalSystem.GetBlocksOfType(_ai,b=&gt;b.CubeGrid==g&amp;&amp;(b.CustomName.Contains("[AI]")||b.BlockDefinition.ToString().Contains("OffensiveCombat")||b.BlockDefinition.ToString().Contains("FlightMovement")));
