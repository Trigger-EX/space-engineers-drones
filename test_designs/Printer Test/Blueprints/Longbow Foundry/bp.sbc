}if(rem&gt;0)note=rem+" blocks not placed yet. "+note;}if(done){b.State="CHARGE";b.T=_now;b.Recompiled=false;b.Msg="";return;}_where="bay "+b.N+" FINISH diagnose";string d=Diagnose(b);b.Msg=(d!=""?d+"\n   ":"")+(b.LBadText!=""?b.LBadText+"\n   ":"")+note;Stall(b);if(b.Starved)b.T+=_dt;else if(t&gt;FinishTimeout)Fault(b,"finish timeout: "+(b.HavePass?b.LBad+" unfinished, "+b.LBlocks+"/"+b.Cells+" blocks. "+b.LBadText:"scan never completed")+(rem&gt;0?" "+rem+" blocks never placed (unsupported?)":""));}bool ScanBox(Bay b,int rem){IMyCubeGrid g=null;try{g=b.Merge.CubeGrid;}catch(Exception ex){Err(ex,b);}if(g==null){
b.LBadText="printer grid not readable (merge block has no grid)";return false;}int sx=b.BMax.X-b.BMin.X+1,sy=b.BMax.Y-b.BMin.Y+1,sz=b.BMax.Z-b.BMin.Z+1;long total=(long)sx*sy*sz;if(b.ScanIdx==0){b.Seen.Clear();b.PassOk=rem&lt;=0;}for(int n=0;n&lt;ScanBudget&amp;&amp;b.ScanIdx&lt;total;n++){long i=b.ScanIdx++;int x=b.BMin.X+(int)(i%sx),y=b.BMin.Y+(int)((i/sx)%sy),z=b.BMin.Z+(int)(i/((long)sx*sy));if(b.Ignore.Contains(Key(x,y,z)))continue;try{var s=g.GetCubeBlock(new Vector3I(x,y,z));if(s==null){if(g.CubeExists(new Vector3I(x,y,z))&amp;&amp;b.Seen.Add(Key(x,y,z))){b.PCells++;b.PBlocks++;b.PBlind++;}continue;}var fb=s.FatBlock;
if(fb!=null&amp;&amp;fb==b.Merge)continue;Vector3I sp=s.Position;if(b.Ignore.Contains(Key(sp.X,sp.Y,sp.Z)))continue;b.PCells++;if(!b.Seen.Add(Key(sp.X,sp.Y,sp.Z)))continue;b.PBlocks++;b.PInteg+=s.BuildIntegrity;bool bad= !s.IsFullIntegrity||(fb!=null&amp;&amp; !fb.IsFunctional);if(bad){b.PBad++;if(b.PBadL.Count&lt;4){string nm=fb!=null?fb.DefinitionDisplayNameText:"block";int pct=s.MaxIntegrity&gt;0?(int)(100*s.BuildIntegrity/s.MaxIntegrity):0;string e=nm+" @"+sp.X+","+sp.Y+","+sp.Z+" "+pct+"%";if(b.PBadL.Count&lt;3&amp;&amp;b.Welders.Count&gt;0){Vector3D wp=g.GridIntegerToWorld(sp);double bd=1e9;foreach(var w in b.Welders){try{bd=Math.Min(bd,Vector3D.Distance(wp,w.GetPosition()));
}catch(Exception){}}e+=" ("+Math.Round(bd,1)+" m from nearest welder)";}b.PBadL.Add(e);}}}catch(Exception ex){Err(ex,b);b.PBad++;if(b.PBadL.Count&lt;3)b.PBadL.Add("cell "+x+","+y+","+z+" unreadable ("+ex.GetType().FullName+")");}}if(b.ScanIdx&lt;total)return false;bool prog= !b.HavePass||b.PBad&lt;b.LBad||b.PInteg&gt;b.LInteg+0.5f||b.PBlocks&gt;b.LBlocks;if(prog)b.LastProgress=_now;b.LBad=b.PBad;b.LBlocks=b.PBlocks;b.LCells=b.PCells;b.LBlind=b.PBlind;b.LInteg=b.PInteg;b.HavePass=true;bool ok=b.PassOk&amp;&amp;b.PBad==0&amp;&amp;b.PBlocks&gt;=b.Cells-b.Tol;if(!ok)b.OkSince= -1;else if(b.PBlind&gt;0){if(b.OkSince&lt;0)b.OkSince=_now;if(_now-b.OkSince&lt;ArmourSettle){
ok=false;b.LBadText="all blocks present ("+b.PBlind+" armour cells unreadable): welding on for "+(int)(ArmourSettle-(_now-b.OkSince))+" s more";ResetScan(b);return false;}}if(b.PBad&gt;0)b.LBadText=b.PBad+" unfinished: "+string.Join("; ",b.PBadL.ToArray());else if(b.PBlocks&lt;b.Cells-b.Tol)b.LBadText="only "+b.PBlocks+" of "+b.Cells+" drone blocks present";else b.LBadText="";ResetScan(b);return ok;}bool FallbackCheck(Bay b,double t){if(_tick%6!=0&amp;&amp;b.HavePass)return b.HavePass&amp;&amp;b.LBad==0&amp;&amp;b.LBlocks&gt;0&amp;&amp;t&gt;=FinishFallback;GridTerminalSystem.GetBlocksOfType(_tmp,x=&gt;x!=null&amp;&amp;x.CustomName.StartsWith(b.Prefix)&amp;&amp; !x.CustomName.Contains("[Bay")&amp;&amp;x.IsSameConstructAs(Me));
int bad=0,n=0;float integ=0;var bl=new List&lt;string&gt;();foreach(var x in _tmp){n++;bool u;try{var gr=x.CubeGrid;var s=gr!=null?gr.GetCubeBlock(x.Position):null;u= !x.IsFunctional||(s!=null&amp;&amp; !s.IsFullIntegrity);if(s!=null)integ+=s.BuildIntegrity;}catch(Exception ex){Err(ex,b);u=true;}if(u){bad++;if(bl.Count&lt;4)bl.Add(x.CustomName);}}if(!b.HavePass||bad&lt;b.LBad||integ&gt;b.LInteg+0.5f||n&gt;b.LBlocks)b.LastProgress=_now;b.LBad=bad;b.LBlocks=n;b.LInteg=integ;b.HavePass=true;b.LBadText=bad&gt;0?bad+" unfinished: "+string.Join("; ",bl.ToArray()):"";return bad==0&amp;&amp;n&gt;0&amp;&amp;t&gt;=FinishFallback;}string WelderReport(Bay b){
int off=0,broken=0,nopower=0;string first="";foreach(var w in b.Welders){string why=null;try{if(!w.IsFunctional){broken++;why="damaged";}else if(!w.Enabled){off++;why="off";}else if(!w.IsWorking){nopower++;why="no power";}if(why!=null&amp;&amp;first.Length&lt;60)first+=(first==""?"":", ")+ShortName(w)+" "+why;}catch(Exception){broken++;}}if(off+broken+nopower==0)return"";return"welders: "+off+" off, "+broken+" damaged, "+nopower+" unpowered ("+first+")";}string ShortName(IMyTerminalBlock x){string n=x.CustomName;int i=n.IndexOf(']');return(i&gt;=0?n.Substring(i+1):n).Trim();}string Diagnose(Bay b){b.Starved=false;
if(!Projecting(b))return"no projection (projector off or blueprint missing)"+(b.ProjErr!=""?" ["+b.ProjErr+"]":"");if(_now-b.LastProgress&lt;=StallSeconds)return"";if(StockEmpty()){b.Starved=true;return"STALLED: component stock empty - refill the [Stock] cargo (timeouts paused)";}string wr=WelderReport(b);if(wr!="")return"STALLED: "+wr;if(b.State=="FINISH")return"STALLED: projection done but blocks are not getting finished: out of weld reach or missing components";if(b.Rem&gt;0&amp;&amp;b.Rem==TotalOf(b))return"STALLED at 0 built: first blocks not supported / merge block not aligned?";int bc=BuildableOf(b);if(b.Rem&gt;0&amp;&amp;bc==0)return"STALLED: "+b.Rem+" blocks left, none buildable - unsupported (nothing to attach to) or out of weld reach";
return"STALLED: "+b.Rem+" blocks left ("+bc+" buildable) - out of weld reach or missing components";}void Stall(Bay b){if(b.Starved||_now-b.LastProgress&lt;=StallSeconds)return;int n=b.Welders.Count;if(b.KickW!=null||n==0||_now-b.KickT&lt;StallSeconds)return;for(int i=0;i&lt;n;i++){var w=b.Welders[(b.KickIdx+i)%n];bool fn=false;try{fn=w.IsFunctional;}catch(Exception){}if(!fn)continue;b.KickIdx=(b.KickIdx+i+1)%n;b.KickW=w;b.KickT=_now;SetOn(w,false);return;}}bool _stockSeen;bool StockEmpty(){if(_stock.Count==0)return false;foreach(var s in _stock){try{var inv=s.GetInventory(0);if(inv!=null&amp;&amp;inv.CurrentVolume.RawValue&gt;2000){
_stockSeen=true;return false;}}catch(Exception){return false;}}return _stockSeen;}bool StayOn(){return WeldersStayOn&amp;&amp; !RackMode;}void Power(Bay b,bool on){_where="bay "+b.N+" "+b.State+" Power projector";SetOn(b.Proj,true);if(!on&amp;&amp;(b.State=="BUILD"||b.State=="FINISH"))return;_where="bay "+b.N+" "+b.State+" Power welders";if(!on)b.KickW=null;else if(b.KickW!=null&amp;&amp;_now-b.KickT&gt;=2){SetOn(b.KickW,true);b.KickW=null;}foreach(var w in b.Welders){if(on&amp;&amp;w==b.KickW)continue;SetOn(w,on);}}Bay Nearest(Vector3D p){Bay best=null;double bd=MatchRadius;foreach(var b in _bays){if(b.Merge==null)continue;try{
double d=Vector3D.Distance(p,b.Merge.GetPosition());if(d&lt;bd){bd=d;best=b;}}catch(Exception){}}return best;}void FindDrone(Bay b){if(b.DPb!=null&amp;&amp;b.DMerge!=null)return;Vector3D mp;try{mp=b.Merge.GetPosition();}catch(Exception ex){Err(ex,b);return;}GridTerminalSystem.GetBlocksOfType(_mergesAll,x=&gt;x!=null&amp;&amp;x.CustomName.StartsWith(b.Prefix)&amp;&amp; !x.CustomName.Contains("[Bay"));b.DMerge=null;double bd=1e9;foreach(var m in _mergesAll){try{Vector3D q=m.GetPosition();double d=Vector3D.Distance(q,mp);if(d&lt;bd&amp;&amp;d&lt;MatchRadius&amp;&amp;Nearest(q)==b){bd=d;b.DMerge=m;}}catch(Exception){}}GridTerminalSystem.GetBlocksOfType(_pbs,x=&gt;x!=null&amp;&amp;x!=Me&amp;&amp; !x.CustomName.Contains("[Bay")&amp;&amp;(x.CustomName.StartsWith(b.Prefix)||x.CustomName.StartsWith("[Staff] "+b.Prefix)||x.CustomName.StartsWith("[Flight] "+b.Prefix)));
b.DPb=null;bd=1e9;int br=9;foreach(var p in _pbs){try{Vector3D q=p.GetPosition();double d=Vector3D.Distance(q,mp);int r=p.CustomName.StartsWith("[Staff]")?0:p.CustomName.StartsWith("[Flight]")?1:2;if((r&lt;br||(r==br&amp;&amp;d&lt;bd))&amp;&amp;Nearest(q)==b){br=r;bd=d;b.DPb=p;}}catch(Exception){}}GridTerminalSystem.GetBlocksOfType(_bats,x=&gt;x!=null&amp;&amp;x.CustomName.StartsWith(b.Prefix)&amp;&amp; !x.CustomName.Contains("[Bay"));b.DBats.Clear();foreach(var x in _bats){try{if(Nearest(x.GetPosition())==b)b.DBats.Add(x);}catch(Exception){}}}bool DroneCharged(Bay b){if(b.DBats.Count==0)return true;foreach(var x in b.DBats){try{if(x.CurrentStoredPower&lt;x.MaxStoredPower*0.95f)return false;
}catch(Exception){}}return true;}void Release(Bay b){Power(b,StayOn());FindDrone(b);b.Away=Vector3D.Zero;if(b.DMerge!=null){try{Vector3D d=b.DMerge.GetPosition()-b.Merge.GetPosition();if(d.LengthSquared()&gt;1e-6)b.Away= -Vector3D.Normalize(d);}catch(Exception ex){Err(ex,b);b.DMerge=null;}}if(!string.IsNullOrEmpty(b.Exit)){MatrixD g=Me.CubeGrid.WorldMatrix;Vector3D ex=Vector3D.Zero;switch(b.Exit.Trim()){case"Forward":ex=g.Forward;break;case"Backward":ex=g.Backward;break;case"Up":ex=g.Up;break;case"Down":ex=g.Down;break;case"Left":ex=g.Left;break;case"Right":ex=g.Right;break;}if(ex.LengthSquared()&gt;0.5)b.Away= -ex;
}b.RackLaunch=RackMode;b.Armed=false;b.LaunchWritten=false;b.FusedT=0;b.Msg="";b.State="ARM";b.T=_now;b.Nudged=false;}bool StillAttached(Bay b){if(b.DPb==null&amp;&amp;b.DMerge==null)return false;try{var g=b.Merge.CubeGrid;if(g==null)return false;return(b.DPb==null||b.DPb.CubeGrid==g)&amp;&amp;(b.DMerge==null||b.DMerge.CubeGrid==g);}catch(Exception ex){Err(ex,b);return false;}}bool Arm(Bay b){FindDrone(b);if(b.DPb==null){b.Ai.Clear();GridTerminalSystem.GetBlocksOfType(_tmp,x=&gt;x!=null&amp;&amp;x.CustomName.StartsWith(b.Prefix)&amp;&amp; !x.CustomName.Contains("[Bay")&amp;&amp;x.CubeGrid==b.Merge.CubeGrid&amp;&amp;(x.BlockDefinition.TypeIdString.Contains("FlightMovement")||x.BlockDefinition.TypeIdString.Contains("CombatBlock"))&amp;&amp;Nearest(x.GetPosition())==b);
b.Ai.AddRange(_tmp);b.Msg=b.Ai.Count&gt;0?"":"ARM: drone PB not visible - relying on the JOIN broadcast";return b.Ai.Count&gt;0;}try{if(!b.LaunchWritten){b.LaunchWritten=true;_where="bay "+b.N+" ARM write drone Custom Data";var ini=new MyIni();MyIniParseResult r;if(ini.TryParse(b.DPb.CustomData??"",out r)){ini.Set("Launch","Auto",!RackMode);ini.Set("Launch","Burst Seconds",b.Burst&gt;=0?b.Burst:LaunchBurst);Vector3D da= -b.Away;ini.Set("Launch","Away X",da.X);ini.Set("Launch","Away Y",da.Y);ini.Set("Launch","Away Z",da.Z);ini.Set("Launch","Exit Direction",b.Exit==null?"":b.Exit.Trim());ini.Set("Launch","Armed",true);
b.DPb.CustomData=ini.ToString();}else b.Msg="ARM: drone Custom Data unreadable - relying on the JOIN broadcast";}_where="bay "+b.N+" ARM run drone PB";b.DPb.Enabled=true;bool ok=b.DPb.TryRun("armed");if(!ok)b.Msg="ARM: drone PB did not run (TryRun false: not compiled or not working yet?) - relying on the JOIN broadcast";else b.Msg="";return ok;}catch(Exception ex){Err(ex,b);b.Msg="ARM failed ("+ex.GetType().FullName+") - relying on the JOIN broadcast";b.DPb=null;return false;}}void Separate(Bay b){_where="bay "+b.N+" Separate batteries";foreach(var x in b.DBats){try{if(x.ChargeMode!=ChargeMode.Auto)x.ChargeMode=ChargeMode.Auto;
}catch(Exception ex){Err(ex,b);}}_where="bay "+b.N+" Separate merge blocks off";SetOn(b.Merge,false);SetOn(b.DMerge,false);foreach(var x in b.Ai){try{x.ApplyAction("OnOff_On");x.ApplyAction("ActivateBehavior_On");}catch(Exception ex){Err(ex,b);}}b.Ai.Clear();b.State="RELEASE";b.T=_now;b.Nudged=false;b.Printed++;}void Nudge(Bay b,double t){if(b.Away.LengthSquared()&lt;0.5)return;bool on=t&lt;NudgeSeconds;if(!on&amp;&amp; !b.Nudged)return;foreach(var th in _thr){try{if(th.CustomName.StartsWith(b.Prefix))continue;if(Vector3D.Dot(th.WorldMatrix.Backward,b.Away)&gt;0.85)th.ThrustOverridePercentage=on?(float)NudgePower:0f;
}catch(Exception){}}b.Nudged=on;}void RelayTargets(){foreach(var t in _turrets){try{if(t.IsFunctional&amp;&amp;t.HasTarget)SendTarget(t.GetTargetedEntity());}catch(Exception){}}foreach(var c in _ctcs){try{if(c.IsFunctional&amp;&amp;c.HasTarget)SendTarget(c.GetTargetedEntity());}catch(Exception){}}}void SendTarget(MyDetectedEntityInfo e){if(e.IsEmpty()||e.Relationship!=MyRelationsBetweenPlayerAndBlock.Enemies)return;var msg=new MyTuple&lt;long,Vector3D,Vector3D,double,long&gt;(e.EntityId,e.Position,new Vector3D(e.Velocity),e.BoundingBox.Size.Length()*0.5,Me.EntityId);foreach(var tag in _lSwarm.Keys)IGC.SendBroadcastMessage(tag+"_TGT",msg);
}void Command(string a){var w=a.Split(' ');int n;switch(w[0]){case"start":Printing=true;break;case"stop":Printing=false;foreach(var b in _bays){try{Power(b,false);}catch(Exception ex){Err(ex,b);}}break;case"max":if(w.Length&gt;1&amp;&amp;int.TryParse(w[1],out n))MaxDrones=n;break;case"release":foreach(var b in _bays)if((b.State=="DOCKED"||b.State=="CHARGE")&amp;&amp;(w.Length&lt;2||(int.TryParse(w[1],out n)&amp;&amp;n==b.N)))Release(b);break;case"hold":if(w.Length&gt;1&amp;&amp;int.TryParse(w[1],out n))foreach(var b in _bays)if(b.N==n)SetHold(b,true);break;case"unhold":if(w.Length&gt;1&amp;&amp;int.TryParse(w[1],out n))foreach(var b in _bays)if(b.N==n){
SetHold(b,false);if(b.State=="FAULT")b.State="IDLE";}break;case"relay":Relay=w.Length&lt;2||w[1]!="off";break;case"reload":LoadConfig();GetBlocks();_errs.Clear();_errTotal=0;foreach(var b in _bays)b.Printed=0;break;}}void Show(){int docked=0;foreach(var d0 in _bays)if(d0.State=="DOCKED")docked++;_sb.Clear();_sb.Append("HIVE MOTHER v").Append(VER).Append(Printing?"  PRINTING":"  STOPPED");if(_errs.Count&gt;0)_sb.Append("   !! ").Append(_errTotal).Append(" ERROR").Append(_errTotal==1?"":"S");_sb.Append('\n');if(RackMode)_sb.Append("Rack: ").Append(docked).Append(" docked, targets ").Append(_targets.Count).Append('\n');
else _sb.Append("Drones alive: ").Append(AliveAll()).Append(" / ").Append(MaxDrones).Append("   building ").Append(PendingAll()).Append('\n');foreach(var b in _bays){try{_sb.Append("Bay ").Append(b.N).Append(' ').Append(b.Tag).Append(": ").Append(b.State);if(b.Printed&gt;0)_sb.Append(" #").Append(b.Printed);if(b.Held)_sb.Append(" (held)");if(b.Piped&gt;=0&amp;&amp;b.Piped&lt;b.Welders.Count)_sb.Append("  PIPES ").Append(b.Piped).Append('/').Append(b.Welders.Count);if(b.State=="BUILD")_sb.Append("  ").Append(b.Rem&gt;=0?b.Rem+" left":"no projection");if(b.State=="FINISH"){long tot=b.HasBox?(long)(b.BMax.X-b.BMin.X+1)*(b.BMax.Y-b.BMin.Y+1)*(b.BMax.Z-b.BMin.Z+1):0;
_sb.Append("  ").Append(b.HasBox?"scan "+(tot&gt;0?100*b.ScanIdx/tot:0)+"%":"name check").Append(b.HavePass?", "+b.LBad+" unfinished":"").Append(", ").Append((int)(_now-b.FinishT)).Append(" s");}if(b.Msg!="")_sb.Append("\n   ").Append(b.Msg);}catch(Exception ex){_sb.Append("(display error ").Append(ex.GetType().FullName).Append(')');Err(ex,b);}_sb.Append('\n');}if(_bays.Count==0)_sb.Append("No bays: name a projector, welders and\na merge block with [Bay 1]\n");_sb.Append(ErrText());int ins=0,max=0;try{ins=Runtime.CurrentInstructionCount;max=Runtime.MaxInstructionCount;}catch(Exception){}_sb.Append("Ins: ").Append(ins).Append(" / ").Append(max).Append("  peak ").Append(_peakIns).Append('\n');
_screen=_sb.ToString();if(_lcd!=null){try{_lcd.WriteText(_screen);}catch(Exception){}}}
