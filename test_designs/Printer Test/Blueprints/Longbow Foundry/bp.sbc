LnBegin();return LnBurn(dt,idle,startMode,cmd);}return false;}_lnS=0;return false;}string LaunchStatus(){if(_lnS==1)return"Launch: docked, waiting for the release\n";if(_lnS==2)return"Launch: take-off burn "+_lnT.ToString("0.0")+" s\n";if(_lnS==3)return _lnMsg!=""?"Launch: "+_lnMsg+"\n":"";if(_lnFused)return"Launch: held, this grid holds a printer\n";return _lnArmed?"Launch: armed\n":"";}class Mate{public long Id;public Vector3D Pos,Vel;public double Seen;public long Tgt;public int Flags;}Dictionary&lt;long,Mate&gt;_mates=new Dictionary&lt;long,Mate&gt;();List&lt;long&gt;_gone=new List&lt;long&gt;();void ReadSwarm(){while(_lSwarm.HasPendingMessage){
