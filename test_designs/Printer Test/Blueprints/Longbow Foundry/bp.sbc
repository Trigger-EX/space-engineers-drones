foreach(var tm in b.Timers){try{if(tm.IsCountingDown)b.TimerSeen=_now;}catch(Exception){}}return _now-b.TimerSeen&lt;3;}void StartBuild(Bay b){b.State="BUILD";b.T=_now;b.Rem= -1;b.LastProgress=_now;b.SawWork=false;SetOn(b.Merge,true);b.Msg="";b.Nudged=false;b.DPb=null;b.DMerge=null;b.DBats.Clear();b.KickW=null;b.Starved=false;b.Armed=false;b.LaunchWritten=false;b.Recompiled=false;b.ProjErr="";KeepProjection(b);}void Fault(Bay b,string why){b.State="FAULT";b.T=_now;b.Msg=why;b.Faults++;Power(b,false);}void EnterFinish(Bay b){b.State="FINISH";b.T=_now;b.FinishT=_now;b.LastProgress=_now;b.Msg="";b.Recompiled=false;
