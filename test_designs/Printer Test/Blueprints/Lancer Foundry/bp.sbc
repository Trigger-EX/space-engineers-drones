DoRecompile=C(S,"Recompile Drone PB Before Release",DoRecompile);RecompileWait=C(S,"Recompile Wait Seconds",RecompileWait);NudgeSeconds=C(S,"Release Nudge Seconds",NudgeSeconds);NudgePower=C(S,"Release Nudge Power (0-1)",NudgePower);GapSeconds=C(S,"Release Gap Seconds",GapSeconds);MatchRadius=C(S,"Drone Match Radius m",MatchRadius);FinishTimeout=C(S,"Finish Timeout Seconds",FinishTimeout);ArmourSettle=C(S,"Armour Settle Seconds",ArmourSettle);FinishFallback=C(S,"Finish Fallback Seconds (used only without Drone Box keys)",FinishFallback);ArmSeconds=C(S,"Arm Max Seconds",ArmSeconds);JoinSeconds=Math.Max(30,C(S,"Join Seconds",JoinSeconds));
