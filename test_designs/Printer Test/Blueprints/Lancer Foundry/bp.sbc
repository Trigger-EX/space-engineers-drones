                      <Program>const string VER="1.0";bool TvOn=true;double TvLostFrac=0.5,TvAimW=2.5,TvHold=1.0,TvHyst=0.1,TvMinNeed=0.3,TvFightRange=1200;IMyShipController _rc;List&lt;IMyThrust&gt;_thr=new List&lt;IMyThrust&gt;();List&lt;IMyThrust&gt;[]_thrDir=new List&lt;IMyThrust&gt;[6];double[]_cap=new double[6],_live=new double[6],_rated=new double[6];int _lost=0,_opt= -1,_in=0;double _optT= -99,_short=0,_now=0,_scanT= -99,_chkT= -99,_dispT= -99,_lastInT= -99;long _grid=0,_addr=0,_tick=0;IMyBroadcastListener _lIn;Vector3D _need;string _err="";StringBuilder _sb=new StringBuilder();const string S="Thrust Vectoring";public Program(){for(int i=0;
i&lt;6;i++)_thrDir[i]=new List&lt;IMyThrust&gt;();Runtime.UpdateFrequency=UpdateFrequency.Update10;_lIn=IGC.RegisterBroadcastListener("TVEC.I");_lIn.SetMessageCallback("tv");Load();Scan();Caps();}void Load(){var ini=new MyIni();MyIniParseResult res;if(!ini.TryParse(Me.CustomData,out res))return;TvOn=B(ini,"Enabled",TvOn);TvLostFrac=D(ini,"Lost Fraction",TvLostFrac);TvAimW=D(ini,"Aim Weight",TvAimW);TvHold=D(ini,"Hold Time (s)",TvHold);TvHyst=D(ini,"Hysteresis",TvHyst);TvMinNeed=D(ini,"Min Force (m/s2)",TvMinNeed);TvFightRange=D(ini,"Fight Range (m)",TvFightRange);string o=ini.ToString();if(o!=Me.CustomData)Me.CustomData=o;
}double D(MyIni i,string k,double d){if(!i.ContainsKey(S,k))i.Set(S,k,d);return i.Get(S,k).ToDouble(d);}bool B(MyIni i,string k,bool d){if(!i.ContainsKey(S,k))i.Set(S,k,d);return i.Get(S,k).ToBoolean(d);}void Scan(){_scanT=_now;_err="";var ctrls=new List&lt;IMyShipController&gt;();GridTerminalSystem.GetBlocksOfType(ctrls,b=&gt;b.IsSameConstructAs(Me)&amp;&amp;b.CanControlShip);_rc=null;foreach(var c in ctrls)if(c is IMyRemoteControl){_rc=c;break;}if(_rc==null&amp;&amp;ctrls.Count&gt;0)_rc=ctrls[0];GridTerminalSystem.GetBlocksOfType(_thr,b=&gt;b.IsSameConstructAs(Me));for(int i=0;i&lt;6;i++)_thrDir[i].Clear();if(_grid!=Me.CubeGrid.EntityId){
_grid=Me.CubeGrid.EntityId;for(int i=0;i&lt;6;i++)_rated[i]=0;_opt= -1;}if(_rc==null){_err="No working Remote Control / cockpit";return;}MatrixD m=_rc.WorldMatrix;Vector3D[]dirs={m.Forward,m.Backward,m.Left,m.Right,m.Up,m.Down};double[]own=new double[6];foreach(var t in _thr){Vector3D push=t.WorldMatrix.Backward;for(int i=0;i&lt;6;i++)if(Vector3D.Dot(push,dirs[i])&gt;0.9){_thrDir[i].Add(t);if(t.CubeGrid==Me.CubeGrid)own[i]+=t.MaxThrust;break;}}for(int i=0;i&lt;6;i++)if(own[i]&gt;_rated[i])_rated[i]=own[i];}void Caps(){if(_now-_chkT&gt;=1){_chkT=_now;bool bad=false;for(int i=0;i&lt;6&amp;&amp; !bad;i++)foreach(var t in _thrDir[i])if(t.Closed|| !t.IsSameConstructAs(Me)){
bad=true;break;}if(bad||_now-_scanT&gt;10)Scan();}int lost=0;for(int i=0;i&lt;6;i++){double c=0,l=0;foreach(var t in _thrDir[i])if(t.IsWorking){c+=t.MaxEffectiveThrust;l+=t.MaxThrust;}_cap[i]=c;_live[i]=l;if(_rated[i]&gt;0&amp;&amp;l&lt;TvLostFrac*_rated[i])lost|=1&lt;&lt;i;}if(!TvOn)lost=0;if(lost!=_lost){_lost=lost;_opt= -1;}}public void Main(string arg,UpdateType src){_tick++;_now+=Runtime.TimeSinceLastRun.TotalSeconds;string a=(arg??"").Trim().ToLowerInvariant();if(a=="reload"){Load();Scan();}else if(a=="reset"){for(int i=0;i&lt;6;i++)_rated[i]=0;Scan();}if(_rc==null|| !_rc.IsFunctional){if(_now-_scanT&gt;=1)Scan();}if((src&amp;UpdateType.Update10)!=0||_lost!=0||_now-_chkT&gt;=1)Caps();
MyIGCMessage last=default(MyIGCMessage);bool got=false;while(_lIn.HasPendingMessage){var m=_lIn.AcceptMessage();if(m.Data is MyTuple&lt;Vector3D,Vector3D,Vector3D,Vector3D,Vector3D,int&gt;){last=m;got=true;}}if(got){_in++;_lastInT=_now;Answer(last);}if(_now-_dispT&gt;=1){_dispT=_now;Display();}}void Answer(MyIGCMessage m){var d=(MyTuple&lt;Vector3D,Vector3D,Vector3D,Vector3D,Vector3D,int&gt;)m.Data;_addr=m.Source;_need=d.Item1;Vector3D fwd=Vector3D.Zero,up=Vector3D.Zero;if(TvOn&amp;&amp;_lost!=0&amp;&amp;_rc!=null)Decide(d.Item1,d.Item2,d.Item3,d.Item4,d.Item5,d.Item6,ref fwd,ref up);else _opt= -1;int state=_lost|((_opt&gt;=0&amp;&amp;_opt&lt;6?_opt+1:0)&lt;&lt;6);
IGC.SendBroadcastMessage("TVEC.O"+m.Source,new MyTuple&lt;Vector3D,Vector3D,int&gt;(fwd,up,state),TransmissionDistance.CurrentConstruct);}Vector3D Rot(Vector3D v,Vector3D axis,double ang){double c=Math.Cos(ang),s=Math.Sin(ang);return v*c+Vector3D.Cross(axis,v)*s+axis*(Vector3D.Dot(axis,v)*(1-c));}Vector3D Across(Vector3D v,Vector3D n){Vector3D r=v-Vector3D.Dot(v,n)*n;return r.LengthSquared()&gt;1e-8?Vector3D.Normalize(r):Vector3D.Zero;}void Decide(Vector3D need,Vector3D wantFwd,Vector3D wantUp,Vector3D gf,Vector3D gu,int flags,ref Vector3D fwd,ref Vector3D up){double mass=_rc.CalculateShipMass().PhysicalMass,F=need.Length();
if(mass&lt;=0||F&lt;TvMinNeed*mass||wantFwd.LengthSquared()&lt;1e-9){_opt= -1;return;}double ps=Math.Max(0.01,(flags&amp;127)/100.0);bool fight=((flags&gt;&gt;7)&amp;4194303)*10.0&lt;TvFightRange;Vector3D nd=need/F,a=Vector3D.Normalize(wantFwd),grav=_rc.GetNaturalGravity();MatrixD rm=_rc.WorldMatrix;Vector3D[]e={rm.Forward,rm.Backward,rm.Left,rm.Right,rm.Up,rm.Down};double psi=Math.Acos(MathHelper.Clamp(Vector3D.Dot(nd,a),-1,1));double[]cost=new double[7],sh=new double[7];Vector3D[]fws=new Vector3D[7];double top=0;for(int k=0;k&lt;6;k++)top=Math.Max(top,_cap[k]*ps);double Fe=Math.Min(F,top);if(Fe&lt;=0){_opt= -1;return;}Vector3D ax=Vector3D.Cross(gf,a);
double an=Math.Acos(MathHelper.Clamp(Vector3D.Dot(gf,a),-1,1));Vector3D ndb=ax.LengthSquared()&gt;1e-12?Rot(nd,Vector3D.Normalize(ax),-an):nd;double got=0;for(int k=0;k&lt;6;k++){double n=Vector3D.Dot(ndb,e[k]);if(n&gt;0)got+=Math.Min(_cap[k]*ps,F*n)*n;}sh[6]=Math.Max(0,Fe-got)/Fe;fws[6]=a;double W=TvAimW*(fight?1.0:0.2);if(grav.LengthSquared()&gt;1&amp;&amp;Vector3D.Dot(nd,-Vector3D.Normalize(grav))&gt;0.3&amp;&amp;sh[6]&gt;0.2)W=0;cost[6]=sh[6]+0.1*an/Math.PI;for(int k=0;k&lt;6;k++){double cap=_cap[k]*ps;if(cap&lt;=0){cost[k]=1e9;continue;}double th=Math.Acos(MathHelper.Clamp(Vector3D.Dot(gf,e[k]),-1,1));Vector3D p=Across(a,nd);if(p.LengthSquared()&lt;0.5)p=Across(gf,nd);
Vector3D fw=p.LengthSquared()&gt;0.5?Vector3D.Normalize(nd*Math.Cos(th)+p*Math.Sin(th)):nd;fws[k]=fw;sh[k]=Math.Max(0,Fe-cap)/Fe;cost[k]=sh[k]+W*Math.Abs(psi-th)/Math.PI+0.1*Math.Acos(MathHelper.Clamp(Vector3D.Dot(gf,fw),-1,1))/Math.PI;}int best=6;double bc=cost[6]-(_opt==6||_opt&lt;0?TvHyst:0);for(int k=0;k&lt;6;k++){double c=cost[k]-(_opt==k?TvHyst:0);if(c&lt;bc){bc=c;best=k;}}if(_opt&gt;=0&amp;&amp;best!=_opt&amp;&amp;_now-_optT&lt;TvHold&amp;&amp;sh[_opt]&lt;0.9)best=_opt;if(best!=_opt){_opt=best;_optT=_now;}_short=sh[best];if(best==6)return;Vector3D fwv=fws[best];fwd=fwv;up=wantUp;Vector3D u2=Across(e[best],gf),w2=Across(nd,fwv);if(u2.LengthSquared()&gt;0.5&amp;&amp;w2.LengthSquared()&gt;0.5){
Vector3D u3=Vector3D.Cross(gf,u2),w3=Vector3D.Cross(fwv,w2);up=fwv*Vector3D.Dot(gu,gf)+w2*Vector3D.Dot(gu,u2)+w3*Vector3D.Dot(gu,u3);}}void Display(){string n="FBLRUD",l="";for(int i=0;i&lt;6;i++)if((_lost&amp;(1&lt;&lt;i))!=0)l+=(l.Length&gt;0?",":"")+n[i];_sb.Clear();_sb.Append("THRUST VECTOR v").Append(VER).Append(TvOn?"":"  (OFF)").Append('\n');if(_err!="")_sb.Append("! ").Append(_err).Append('\n');_sb.Append("Flight : ").Append(_in==0?"no message yet":"link OK, "+(_now-_lastInT).ToString("0.0")+" s ago").Append('\n');_sb.Append(l==""?"Thrust : all groups ok\n":"!! THRUST LOST "+l+"  "+(_opt&gt;=0&amp;&amp;_opt&lt;6?"vectoring "+n[_opt]:"aim as is")+(_short&gt;0.05?"  short "+(_short*100).ToString("0")+"%":"")+"\n");
_sb.Append("Groups : ");for(int i=0;i&lt;6;i++)_sb.Append(n[i]).Append(' ').Append(_rated[i]&gt;0?(_live[i]/_rated[i]*100).ToString("0")+"%":"-").Append(i&lt;5?"  ":"\n");var s=Me.GetSurface(0);s.ContentType=ContentType.TEXT_AND_IMAGE;s.FontSize=0.8f;s.Font="Monospace";s.WriteText(_sb);Echo(_sb.ToString());}
</Program>
