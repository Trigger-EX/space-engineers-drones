if(FleetOk(d))_rel[d.Item1]=d;}if(_fk==""||_tick-_f2sTick&gt;90){_rel.Clear();return;}_gone.Clear();foreach(var kv in _rel){if(_gone.Count&gt;=10)break;IGC.SendBroadcastMessage(_fk+".TGT",kv.Value,TransmissionDistance.CurrentConstruct);_gone.Add(kv.Key);}foreach(var id in _gone)_rel.Remove(id);}void SendFol(bool burn){if(_fk=="")return;bool fol=_mode==Mode.FOLLOW;if(burn==_folBurn&amp;&amp;fol==_folFol&amp;&amp;_tick%(fol||burn?2:30)!=1)return;_folBurn=burn;_folFol=fol;bool known=FollowKnown();Vector3D want=known&amp;&amp;fol?FollowWant(_rc.GetPosition(),_aBrake,Vector3D.Zero):Vector3D.Zero;int f=(known?1:0)|(_foOnFoot?2:0)|(burn?4:0)|(_now-_dynHomeT&lt;5?8:0);
IGC.SendBroadcastMessage(_fk+".FOL",new MyTuple&lt;Vector3D,Vector3D,Vector3D,Vector3D,Vector3D,int&gt;(want,known?FollowPos():Vector3D.Zero,known?FollowVel():Vector3D.Zero,_dynHome,new Vector3D(FoEngage,FoLeash,0),f),TransmissionDistance.CurrentConstruct);}void PollSensors(){foreach(var s in _sensors){if(!s.IsWorking)continue;_sensed.Clear();s.DetectedEntities(_sensed);foreach(var e in _sensed)FollowSensed(e);}}void Watch(bool burn){bool down=_f2sN&gt;0&amp;&amp;(_tick-_f2sTick&gt;90||(_fpb!=null&amp;&amp; !_fpb.IsWorking));if(!down){_down=false;return;}if(burn||_lnS==2)return;bool first= !_down;_down=true;if(!first&amp;&amp;_now-_relT&lt;1)return;
_relT=_now;foreach(var y in _gyros){y.GyroOverride=false;y.Pitch=0;y.Yaw=0;y.Roll=0;}foreach(var t in _thr)t.ThrustOverridePercentage=0;if(_rc!=null)_rc.DampenersOverride=true;if(first){foreach(var a in _ai)a.Enabled=false;foreach(var g in _guns)if(g.IsFunctional)g.ApplyAction("Shoot_Off");}}void Local(string a){var w=a.Trim().ToLowerInvariant().Split(new[]{' '},StringSplitOptions.RemoveEmptyEntries);if(w.Length==0)return;switch(w[0]){case"follow":case"escort":FoSetSat(false);break;case"satellite":case"sat":case"orbit":FoSetSat(true);break;case"armed":case"launch":case"disarm":LaunchCmd(w[0]);break;
case"reload":GetBlocks();LoadMods();break;}}void Fwd(string c){if(_fk!="")IGC.SendBroadcastMessage(_fk+".S2F",c,TransmissionDistance.CurrentConstruct);}void Command(string a){Local(a);Fwd(a);}void Cb(string c){Local(c);Fwd(c);}void Display(){_sb.Clear();_sb.Append("LANCER STAFF v").Append(VER).Append('\n');if(_fpb==null)_sb.Append("! no [Flight] PB on this construct\n");else if(_down||(_f2sN&gt;0&amp;&amp; !_fpb.IsWorking))_sb.Append("FLIGHT PB DOWN  ").Append((_now-_f2sT).ToString("0.0")).Append(" s silent\n");else if(_f2sN==0)_sb.Append("Flight : waiting for the first message\n");else _sb.Append("Flight : link OK  F2S ").Append((_now-_f2sT).ToString("0.00")).Append(" s ago\n");
_sb.Append("Mode   : ").Append(_mode).Append('\n');if(_rc==null|| !_rc.IsFunctional)_sb.Append("! No working Remote Control / cockpit\n");_sb.Append(FollowStatus());if(_tgtId!=0){_sb.Append("Target : ").Append(_tgtId).Append("  range ").Append(_rc!=null?Vector3D.Distance(_tgtPos,_rc.GetPosition()).ToString("0"):"?").Append(" m\n");_sb.Append("Aim err: ").Append(_aimErr.ToString("0.00")).Append(" / ").Append(_fireWin.ToString("0.00")).Append(" deg").Append((_fl&amp;8)!=0?"  FIRING":"").Append('\n');}else _sb.Append("Target : none\n\n");int rk=(_fl&gt;&gt;8)&amp;255;_sb.Append("Battery: ").Append((_batt*100).ToString("0")).Append("%  Ammo ").Append(rk==255?"?":rk.ToString()).Append('\n');
if(_gate!=""&amp;&amp;_tgtId!=0)_sb.Append("Hold   : ").Append(_gate).Append('\n');_sb.Append("Hive   : ").Append(_mates.Count+1).Append((_fl&amp;16)!=0?"  !! UNDER FIRE":"").Append((_fl&amp;32)!=0?"  lock stale":"").Append((_fl&amp;64)!=0?"  AI searching":"").Append('\n');_sb.Append(LaunchStatus());if(Me.OwnerId==0)_sb.Append("! PB has no owner: set ownership\n");if(_crash!="")_sb.Append("! ").Append(_crash).Append('\n');string s=_sb.ToString();if(_lcd!=null)_lcd.WriteText(s);Echo(s);}
</Program>
