Vector3D _agFwd;int _agFound= -1;List&lt;ITerminalProperty&gt;_agProps=new List&lt;ITerminalProperty&gt;();void AiGateLoad(){var ini=new MyIni();MyIniParseResult res;if(!ini.TryParse(Me.CustomData,out res))return;const string S="AI Gate";if(!ini.ContainsKey(S,"Time-share With Script Search"))ini.Set(S,"Time-share With Script Search",AiGateOn);if(!ini.ContainsKey(S,"Switch On AI Behavior"))ini.Set(S,"Switch On AI Behavior",AiBehaviorSwitch);if(!ini.ContainsKey(S,"Use Typed AI Block API"))ini.Set(S,"Use Typed AI Block API",AiTyped);if(!ini.ContainsKey(S,"AI Flight Speed Limit (m/s)"))ini.Set(S,"AI Flight Speed Limit (m/s)",AiSpeed);
