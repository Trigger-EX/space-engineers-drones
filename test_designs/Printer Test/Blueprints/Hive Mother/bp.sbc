b.PassOk=false;}void StepFinish(Bay b,double t){int rem=RemNow(b);bool done=false;string note="";if(b.SkipFinish){done=true;note="finish check skipped (Skip Finish Check)";}else{if(b.HasBox){_where="bay "+b.N+" FINISH scan box";done=ScanBox(b,rem)&amp;&amp;rem&lt;=0;}else{_where="bay "+b.N+" FINISH name check";done=FallbackCheck(b,_now-b.FinishT)&amp;&amp;rem&lt;=0;note="no Drone Box keys: block-name check + "+(int)FinishFallback+" s timer, armour not verified"+(b.CfgWarn!=""?" ("+b.CfgWarn+")":"");}if(rem&gt;0)note=rem+" blocks not placed yet. "+note;}if(done){b.State="CHARGE";b.T=_now;b.Recompiled=false;b.Msg="";return;
}_where="bay "+b.N+" FINISH diagnose";string d=Diagnose(b);b.Msg=(d!=""?d+"\n   ":"")+(b.LBadText!=""?b.LBadText+"\n   ":"")+note;Stall(b);if(b.Starved)b.T+=_dt;else if(t&gt;FinishTimeout)Fault(b,"finish timeout: "+(b.HavePass?b.LBad+" unfinished, "+b.LBlocks+"/"+b.Cells+" blocks. "+b.LBadText:"scan never completed")+(rem&gt;0?" "+rem+" blocks never placed (unsupported?)":""));}bool ScanBox(Bay b,int rem){IMyCubeGrid g=null;try{g=b.Merge.CubeGrid;}catch(Exception ex){Err(ex,b);}if(g==null){b.LBadText="printer grid not readable (merge block has no grid)";return false;}int sx=b.BMax.X-b.BMin.X+1,sy=b.BMax.Y-b.BMin.Y+1,sz=b.BMax.Z-b.BMin.Z+1;
long total=(long)sx*sy*sz;if(b.ScanIdx==0){b.Seen.Clear();b.PassOk=rem&lt;=0;}for(int n=0;n&lt;ScanBudget&amp;&amp;b.ScanIdx&lt;total;n++){long i=b.ScanIdx++;int x=b.BMin.X+(int)(i%sx),y=b.BMin.Y+(int)((i/sx)%sy),z=b.BMin.Z+(int)(i/((long)sx*sy));if(b.Ignore.Contains(Key(x,y,z)))continue;try{var s=g.GetCubeBlock(new Vector3I(x,y,z));if(s==null){if(g.CubeExists(new Vector3I(x,y,z))&amp;&amp;b.Seen.Add(Key(x,y,z))){b.PCells++;b.PBlocks++;b.PBlind++;}continue;}var fb=s.FatBlock;if(fb!=null&amp;&amp;fb==b.Merge)continue;Vector3I sp=s.Position;if(b.Ignore.Contains(Key(sp.X,sp.Y,sp.Z)))continue;b.PCells++;if(!b.Seen.Add(Key(sp.X,sp.Y,sp.Z)))continue;
b.PBlocks++;b.PInteg+=s.BuildIntegrity;bool bad= !s.IsFullIntegrity||(fb!=null&amp;&amp; !fb.IsFunctional);if(bad){b.PBad++;if(b.PBadL.Count&lt;4){string nm=fb!=null?fb.DefinitionDisplayNameText:"block";int pct=s.MaxIntegrity&gt;0?(int)(100*s.BuildIntegrity/s.MaxIntegrity):0;string e=nm+" @"+sp.X+","+sp.Y+","+sp.Z+" "+pct+"%";if(b.PBadL.Count&lt;3&amp;&amp;b.Welders.Count&gt;0){Vector3D wp=g.GridIntegerToWorld(sp);double bd=1e9;foreach(var w in b.Welders){try{bd=Math.Min(bd,Vector3D.Distance(wp,w.GetPosition()));}catch(Exception){}}e+=" ("+Math.Round(bd,1)+" m from nearest welder)";}b.PBadL.Add(e);}}}catch(Exception ex){Err(ex,b);
