AiSpeed=Math.Max(1,ini.Get(S,"AI Flight Speed Limit (m/s)").ToDouble(AiSpeed));AiWin=Math.Max(1,ini.Get(S,"AI Window (s)").ToDouble(AiWin));ScriptWin=Math.Max(1,ini.Get(S,"Script Search Window (s)").ToDouble(ScriptWin));AiHoldMax=Math.Max(AiWin,ini.Get(S,"Max AI Hold (s)").ToDouble(AiHoldMax));AiSearchEvery=Math.Max(0,ini.Get(S,"AI Search Interval (s)").ToInt32(AiSearchEvery));}void AiGateFind(List&lt;IMyFunctionalBlock&gt;ai){if(AiSearchEvery&gt;0)foreach(var b in ai){var oc=b as IMyOffensiveCombatBlock;if(oc!=null)oc.UpdateTargetInterval=AiSearchEvery;}if(!AiBehaviorSwitch||ai.Count==0)return;int n=0;
