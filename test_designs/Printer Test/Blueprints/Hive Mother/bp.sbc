else _sb.Append("Flight : link OK  F2S ").Append((_now-_f2sT).ToString("0.00")).Append(" s ago\n");_sb.Append("Mode   : ").Append(_mode).Append('\n');if(_rc==null|| !_rc.IsFunctional)_sb.Append("! No working Remote Control / cockpit\n");if(_tgtId!=0){_sb.Append("Target : ").Append(_tgtId).Append("  range ").Append(_rc!=null?Vector3D.Distance(_tgtPos,_rc.GetPosition()).ToString("0"):"?").Append(" m\n");_sb.Append("Aim err: ").Append(_aimErr.ToString("0.00")).Append(" / ").Append(_fireWin.ToString("0.00")).Append(" deg").Append((_fl&amp;8)!=0?"  FIRING":"").Append('\n');}else _sb.Append("Target : none\n\n");
