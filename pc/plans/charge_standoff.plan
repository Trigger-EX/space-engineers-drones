# Charge test: each main drone design alone vs the Tech Hunter flying straight at it at 100 m/s from 3000 m, 20 seeds per line, fight cap 120 s.
# One line per (design, standoff). name = charge-<design>-<standoff>; "default" = the shipped script/blueprint setting. Needs pc/enemies/Tech Hunter and the blueprints in out/Blueprints.
# Report: python3 -I tools/charge_standoff_report.py pc/results   (regenerate this file: python3 -I tools/gen_charge_plan.py --seeds N)
# Run a few lines only: run_plan.sh plans/charge_standoff.plan --only charge-Hornet-300,charge-Hornet-default
# --- Hornet: gatling, script Max Fire Range 700
charge-Hornet-default | run --kind enemy --filter "^enemy/Tech Hunter-vs-Hornet$" --enemy-fleets "Hornet" --enemies enemies --pirate-rush true --pirate-cruise-speed 100 --start-distance 3000:3000 --cap-seconds 120 --seeds 20 --resume --out {OUT}
charge-Hornet-200 | run --kind enemy --filter "^enemy/Tech Hunter-vs-Hornet$" --enemy-fleets "Hornet" --enemies enemies --pirate-rush true --pirate-cruise-speed 100 --start-distance 3000:3000 --cap-seconds 120 --seeds 20 --resume --custom-data "[Hornet]\nStandoff Range=200" --out {OUT}
charge-Hornet-300 | run --kind enemy --filter "^enemy/Tech Hunter-vs-Hornet$" --enemy-fleets "Hornet" --enemies enemies --pirate-rush true --pirate-cruise-speed 100 --start-distance 3000:3000 --cap-seconds 120 --seeds 20 --resume --custom-data "[Hornet]\nStandoff Range=300" --out {OUT}
