# --- Ballista: 27 large railguns, Helm weapon range 0.85 x 2000 m
charge-Ballista-default | run --kind enemy --filter "^enemy/Tech Hunter-vs-Ballista$" --enemy-fleets "Ballista" --enemies enemies --pirate-rush true --pirate-cruise-speed 100 --start-distance 3000:3000 --cap-seconds 120 --seeds 20 --resume --pb-custom-data "Helm=[Link]\nBlock Prefix=[SH]\n\n[Shrike]\nIGC Tag=BALLISTA\nAI Block Search Assist=true\nStart Mode (GUARD/HUNT/ASSIST/IDLE)=HUNT\nStandoff Range=1600\nMin Range=900\nEvasive Jinking=true\nOrbit Speed=30\nCombat Speed=100\n\n[Battery]\nPrimary (AUTO/B1..B4)=B1\nStandoff By Weapons=false\nSalvo (AUTO/ON/OFF)=ON\n" --out {OUT}
