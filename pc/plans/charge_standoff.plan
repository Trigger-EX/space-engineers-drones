# --- Mantis: small railgun 1400 m (default Engage Cap 650 only limits the automatic range)
charge-Mantis-default | run --kind enemy --filter "^enemy/Tech Hunter-vs-Mantis$" --enemy-fleets "Mantis" --enemies enemies --pirate-rush true --pirate-cruise-speed 100 --start-distance 3000:3000 --cap-seconds 120 --seeds 20 --resume --out {OUT}
charge-Mantis-300 | run --kind enemy --filter "^enemy/Tech Hunter-vs-Mantis$" --enemy-fleets "Mantis" --enemies enemies --pirate-rush true --pirate-cruise-speed 100 --start-distance 3000:3000 --cap-seconds 120 --seeds 20 --resume --custom-data "[Mantis]\nForced Range (0: auto)=300" --out {OUT}
